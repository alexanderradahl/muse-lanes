#!/usr/bin/env python3
"""muse-lane: supervisor for long headless Muse runs.

One lane = one or more briefs run in sequence in one cwd, with retries,
stall detection, optional acceptance command, and a summary.
Stdlib only.
"""
import argparse
import datetime
import errno
import fcntl
import fnmatch
import hashlib
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time

TERMINAL = {"done", "failed", "gave_up", "stopped", "review_failed"}
NON_TERMINAL = {"queued", "running", "retry_wait", "accepting"}

DEFAULT_POLL_SEC = 15.0
DEFAULT_BACKOFF = [120.0, 300.0, 600.0, 1200.0, 1800.0, 1800.0]
MAX_ATTEMPTS = 6
ACCEPT_TIMEOUT_SEC = 2 * 3600
REVIEW_TIMEOUT_SEC = 30 * 60
REVIEW_DIFF_CAP = 80000
REVIEW_PREVIEW_CHARS = 2000
REVIEW_HEADING = "Muse pre-review (not the independent review)"
CONSULT_TIMEOUT_SEC = 15 * 60
CONSULT_MAX_DEFAULT = 3
CONSULT_QUESTION_PREVIEW = 500
CONSULT_ANSWER_PREVIEW = 300
CONSULT_PREFIX_LINES = [
    "You can ask the supervisor a question at any time by writing .lane/ASK.md (state your question and paths worth reading).",
    "The supervisor will rename it to .lane/ASK-<n>.md and answer in .lane/ANSWER.md (also saved as .lane/ANSWER-<n>.md).",
    "Keep working meanwhile if you can; check .lane/ANSWER.md for the reply instead of stalling.",
]
LOCK_NAME = "supervisor.lock"
STOP_MARKER = "stop.requested"
ANNOUNCE_MARKER = "announced"
ORPHAN_MARKER_PREFIX = "announced-orphan-"
LEAD_MARKER_PREFIX = "announced-lead-"
MIN_SECRET_LEN = 12
QUEUED_ORPHAN_AFTER_SEC = 30.0
LOCK_RETRY_SEC = 2.0
ACK_EXISTS_EXIT = 3
CLASSIFY_TAIL_LINES = 40
NEEDS_LEAD_KINDS = {"question", "review_failed", "accept_failed_code",
                    "accept_failed_harness", "box_wait_timeout",
                    "scope_violation"}
ACCEPT_MAPPABLE_KINDS = {"accept_failed_code", "accept_failed_harness",
                         "box_wait_timeout"}
CONFIG_KEYS = ("accept_exit_kinds", "box_wait_max_min", "lease_file",
               "lease_claim_re", "lease_release_re", "advisor_cmd",
               "advisor_timeout_min")
DEFAULT_ADVISOR_CMD = ["claude", "-p", "--model", "{model}",
                       "--tools", "Read,Grep,Glob",
                       "--permission-mode", "dontAsk",
                       "--no-session-persistence",
                       "--settings", '{"disableAllHooks":true}']
NEEDS_LEAD_RE = r"^LANE-NEEDS-LEAD: (\S+) ?(.*)$"
SCOPE_DETAIL_CAP = 2000
NEEDS_LEAD_DETAIL_CAP = 2000
ADVISOR_ANSWER_CAP = 8000
ADVISOR_DEFAULT_MODEL = "sonnet"
ADVISOR_DEFAULT_MAX = 3
ADVISOR_MODELS = ("sonnet", "opus")
ADVISOR_ERROR_CAP = 300
ADVISOR_FORBIDDEN_TOOLS = ("Bash", "Edit", "Write", "NotebookEdit")
BOXES_DIR = "_boxes"
LEAD_SIDECAR_PREFIX = "lead-"
LEAD_SIDECAR_SUFFIX = ".json"
LEAD_SIDECAR_MERGED_SUFFIX = ".merged"


def lanes_root():
    p = os.environ.get("MUSE_LANES_ROOT") or os.path.expanduser("~/.muse-lanes")
    return os.path.abspath(os.path.expanduser(p))


def lane_dir(lane_id):
    return os.path.join(lanes_root(), lane_id)


def default_config():
    return {
        "accept_exit_kinds": {},
        "box_wait_max_min": 30,
        "lease_file": None,
        "lease_claim_re": None,
        "lease_release_re": None,
        "advisor_cmd": list(DEFAULT_ADVISOR_CMD),
        "advisor_timeout_min": 15,
    }


def config_file_path():
    """Configured file, or None for defaults. Env wins over the root file."""
    env = os.environ.get("MUSE_LANES_CONFIG")
    if env and str(env).strip():
        return os.path.abspath(os.path.expanduser(str(env).strip())), True
    root_p = os.path.join(lanes_root(), "config.json")
    if os.path.isfile(root_p):
        return root_p, False
    return None, False


def _is_num(v):
    return isinstance(v, (int, float)) and not isinstance(v, bool)


def _validate_config_key(key, val):
    """(ok, normalized_or_reason)."""
    if key == "accept_exit_kinds":
        if not isinstance(val, dict):
            return False, "must be an object mapping exit codes to kinds"
        norm = {}
        for k, v in val.items():
            try:
                code = int(str(k).strip())
            except (TypeError, ValueError):
                return False, "key %r is not an exit code" % (k,)
            if code < 0 or code > 255:
                return False, "exit code %r out of range 0-255" % (k,)
            if not isinstance(v, str) or v not in ACCEPT_MAPPABLE_KINDS:
                return False, "value %r must be one of %s" % (
                    v, sorted(ACCEPT_MAPPABLE_KINDS))
            norm[str(code)] = v
        return True, norm
    if key == "box_wait_max_min":
        if not _is_num(val) or val <= 0:
            return False, "must be a number > 0"
        return True, val
    if key == "lease_file":
        if val is not None and not isinstance(val, str):
            return False, "must be a string or null"
        return True, val
    if key in ("lease_claim_re", "lease_release_re"):
        if val is not None:
            if not isinstance(val, str):
                return False, "must be a string or null"
            try:
                re.compile(val)
            except re.error as e:
                return False, "invalid regex: %s" % e
        return True, val
    if key == "advisor_cmd":
        if (not isinstance(val, list) or not val or
                not all(isinstance(x, str) for x in val)):
            return False, "must be a non-empty list of strings"
        return True, list(val)
    if key == "advisor_timeout_min":
        if not _is_num(val) or val <= 0:
            return False, "must be a number > 0"
        return True, val
    return True, val


def load_effective_config():
    """(config, error). Unknown keys ignored; malformed names the key."""
    cfg = default_config()
    path, from_env = config_file_path()
    if path is None:
        return cfg, None
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            raw = json.load(f)
    except FileNotFoundError:
        if from_env:
            return None, "config file not found: %s" % path
        return cfg, None
    except (OSError, ValueError) as e:
        return None, "malformed config file %s: %s" % (path, e)
    if not isinstance(raw, dict):
        return None, "malformed config file %s: must be a JSON object" % path
    for key in CONFIG_KEYS:
        if key not in raw:
            continue
        ok, norm = _validate_config_key(key, raw[key])
        if not ok:
            return None, "invalid config key %r in %s: %s" % (key, path, norm)
        cfg[key] = norm
    return cfg, None


def lead_marker_name(seq):
    return "%s%s" % (LEAD_MARKER_PREFIX, seq)


def is_lead_announced(ldir, seq):
    if seq is None:
        return False
    try:
        return os.path.exists(os.path.join(ldir, lead_marker_name(seq)))
    except OSError:
        return False


def parse_needs_lead_last(log_text):
    """Last LANE-NEEDS-LEAD line: (kind, detail, raw) or None."""
    if not log_text:
        return None
    last = None
    for line in str(log_text).splitlines():
        m = re.match(NEEDS_LEAD_RE, line)
        if m:
            last = (m.group(1), m.group(2) or "", line.strip())
    return last


def accept_needs_lead_for_exit(exit_code, log_text, config):
    """(kind, detail) for a nonzero accept exit; the last line wins."""
    last = parse_needs_lead_last(log_text or "")
    if last is not None:
        kind_raw, detail_raw, raw_line = last
        if kind_raw in NEEDS_LEAD_KINDS:
            return kind_raw, (detail_raw or "").strip()[:NEEDS_LEAD_DETAIL_CAP]
        return "accept_failed_code", raw_line[:NEEDS_LEAD_DETAIL_CAP]
    mapping = {}
    try:
        mapping = (config or {}).get("accept_exit_kinds") or {}
    except Exception:
        mapping = {}
    mapped = None
    if isinstance(mapping, dict):
        mapped = mapping.get(str(exit_code))
        if mapped is None:
            try:
                mapped = mapping.get(int(str(exit_code)))
            except (TypeError, ValueError):
                mapped = None
    if isinstance(mapped, str) and mapped in ACCEPT_MAPPABLE_KINDS:
        return mapped, "accept exit %s" % exit_code
    return "accept_failed_code", "accept exit %s" % exit_code


def parse_escalate_reason(text):
    """Reason after ESCALATE:, or None. First non-blank line wins.

    Leading markdown/quote chars (backticks, asterisks, underscores, >)
    and whitespace are stripped before matching the case-sensitive word.
    """
    if not text:
        return None
    for line in str(text).splitlines():
        if not line.strip():
            continue
        s = re.sub(r"^[\s`*>_]+", "", line)
        if s.startswith("ESCALATE:"):
            return s[len("ESCALATE:"):].strip()
        return None
    return None


def build_advisor_cmd(advisor_cmd, model, claude_bin=None):
    """Advisor argv with {model} filled; $CLAUDE_BIN overrides argv[0]."""
    base = list(advisor_cmd) if isinstance(advisor_cmd, list) and advisor_cmd else list(DEFAULT_ADVISOR_CMD)
    filled = [str(p).replace("{model}", str(model)) for p in base]
    override = (claude_bin or "").strip() if isinstance(claude_bin, str) else ""
    if override:
        filled[0] = override
    return filled


def build_advisor_prompt(question, ask_name, accept_cmd, scope_globs, step, n):
    """Stdin prompt for the advisor: question, paths, accept, scope, rules."""
    q = (question or "(empty)").strip() or "(empty)"
    scope_txt = ", ".join(scope_globs) if scope_globs else "(none)"
    L = []
    L.append("You are the advisor for a Muse lane. Answer one mid-step question.")
    L.append("Read-only: do not modify, create, or delete any files. Do not run long commands.")
    L.append("")
    L.append("Question from step %d (saved as .lane/%s):" % (step, ask_name))
    L.append("")
    L.append(q)
    L.append("")
    L.append("Acceptance command (you may not change it): %s" % (accept_cmd or "(none)"))
    L.append("Scope (allowed globs, you may not change it): %s" % scope_txt)
    L.append("Read the .lane/%s file and any paths the question names." % ask_name)
    L.append("")
    L.append("If this needs a lead decision (different acceptance, scope, or a product choice),")
    L.append("answer with the first line ESCALATE: <one line> and nothing else.")
    L.append("Keep the answer short and concrete; cite file:line paths you read.")
    return "\n".join(L) + "\n"


def advisor_cmd_forbidden_tool(advisor_cmd):
    """First forbidden tool named in any --tools value, or None.

    The advisor is read-only; only start() calls this, on the configured
    command. Tokens compare whole (NotebookEdit is not Edit).
    """
    if not isinstance(advisor_cmd, list):
        return None
    vals = []
    for i, arg in enumerate(advisor_cmd):
        if not isinstance(arg, str):
            continue
        if arg == "--tools":
            if i + 1 < len(advisor_cmd) and isinstance(advisor_cmd[i + 1], str):
                vals.append(advisor_cmd[i + 1])
        elif arg.startswith("--tools="):
            vals.append(arg[len("--tools="):])
    for v in vals:
        for tok in str(v).split(","):
            if tok.strip() in ADVISOR_FORBIDDEN_TOOLS:
                return tok.strip()
    return None


def box_name_error(name):
    """None when name is a usable box name, else a reason string."""
    if not isinstance(name, str) or not name:
        return "must be non-empty"
    if name in (".", ".."):
        return "must not be '.' or '..'"
    if "/" in name:
        return "must not contain '/'"
    if "\0" in name:
        return "must not contain NUL"
    return None


def boxes_root(root=None):
    return os.path.join(root or lanes_root(), BOXES_DIR)


def box_ticket_stamp(dt=None):
    """UTC stamp for a ticket name. Fixed width, no dashes, sorts in time order."""
    if dt is None:
        dt = datetime.datetime.now(datetime.timezone.utc)
    return dt.strftime("%Y%m%dT%H%M%S.%f")


def parse_box_ticket_name(fn):
    """(queued_key, lane_id) for `<queued>-<lane id>`, else None.

    Lenient on purpose: anything with a non-empty head and tail around the
    first dash parses, so hand-made tickets still list. Unparseable names
    are ignored by the queue, never blockers.
    """
    if not isinstance(fn, str) or "-" not in fn:
        return None
    q, lid = fn.split("-", 1)
    if not q or not lid:
        return None
    if "/" in q or "/" in lid or lid in (".", ".."):
        return None
    return (q, lid)


def list_box_tickets(box, root=None):
    """Sorted [(ticket_name, lane_id)] of parseable tickets for a box."""
    bdir = os.path.join(boxes_root(root), box)
    try:
        fns = os.listdir(bdir)
    except OSError:
        return []
    out = []
    for fn in fns:
        p = parse_box_ticket_name(fn)
        if p is None:
            continue
        if not os.path.isfile(os.path.join(bdir, fn)):
            continue
        out.append((fn, p[1]))
    out.sort(key=lambda t: t[0])
    return out


def box_ticket_owner_alive(lane_id):
    """True when the ticket owner's supervisor currently holds its lock.

    Flock probe only (see supervisor_alive): no process-name matching.
    """
    try:
        return supervisor_alive(lane_dir(lane_id))
    except Exception:
        return False


def box_older_live_tickets(box, my_name, my_lane_id, root=None):
    """Names of older tickets whose lane supervisor is alive. Own lane skipped."""
    older = []
    for fn, lid in list_box_tickets(box, root):
        if fn >= my_name:
            break
        if lid == my_lane_id:
            continue
        if box_ticket_owner_alive(lid):
            older.append(fn)
    return older


def find_own_box_tickets(lane_id, root=None):
    """[(box, ticket_name)] of this lane's tickets across all boxes."""
    found = []
    broot = boxes_root(root)
    try:
        boxes = os.listdir(broot)
    except OSError:
        return found
    for box in boxes:
        bdir = os.path.join(broot, box)
        if not os.path.isdir(bdir):
            continue
        try:
            fns = os.listdir(bdir)
        except OSError:
            continue
        for fn in fns:
            p = parse_box_ticket_name(fn)
            if p is not None and p[1] == lane_id:
                found.append((box, fn))
    return found


def remove_box_ticket(box, ticket_name, root=None):
    try:
        os.remove(os.path.join(boxes_root(root), box, ticket_name))
        return True
    except OSError:
        return False


def move_own_box_tickets(lane_id, new_box, root=None):
    """Move this lane's tickets into box new_box. Returns [new names].

    Each moved ticket gets a fresh stamp (now): it joins the BACK of the
    target queue. Keeping the old stamp would let it jump ahead of the
    lane already holding the target box.
    """
    broot = boxes_root(root)
    target = os.path.join(broot, new_box)
    os.makedirs(target, exist_ok=True)
    moved = []
    for box, fn in find_own_box_tickets(lane_id, root):
        src = os.path.join(broot, box, fn)
        try:
            with open(src, "r", encoding="utf-8", errors="replace") as f:
                old_body = json.load(f)
            old_pid = old_body.get("pid") if isinstance(old_body, dict) else None
        except (OSError, ValueError):
            old_pid = None
        for _try in range(5):
            now = datetime.datetime.now(datetime.timezone.utc)
            cand = "%s-%s" % (box_ticket_stamp(now), lane_id)
            dst = os.path.join(target, cand)
            body = json.dumps({"lane": lane_id, "box": new_box,
                               "queued_at": now.isoformat(),
                               "moved_from": box,
                               "moved_at": now.isoformat(),
                               "pid": old_pid}) + "\n"
            try:
                fd = os.open(dst, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
            except FileExistsError:
                time.sleep(0.002)
                continue
            try:
                with os.fdopen(fd, "w", encoding="utf-8") as f:
                    f.write(body)
            except OSError:
                try:
                    os.remove(dst)
                except OSError:
                    pass
                raise
            try:
                os.remove(src)
            except OSError:
                pass
            moved.append(cand)
            break
    return moved


def box_holder_and_queue(box, tickets=None, root=None):
    """(holder_lane, queue) for a box from its tickets.

    Dead lanes' tickets are skipped, not removed. The holder is the oldest
    live ticket whose lane state shows box_state held; every other live
    ticket lane queues oldest-first.
    """
    if tickets is None:
        tickets = list_box_tickets(box, root)
    holder = None
    queue = []
    for _fn, lid in sorted(tickets, key=lambda t: t[0]):
        if not box_ticket_owner_alive(lid):
            continue
        held = False
        try:
            st = load_json(os.path.join(lane_dir(lid), "state.json"), None)
            held = isinstance(st, dict) and st.get("box_state") == "held"
        except Exception:
            held = False
        if held and holder is None:
            holder = lid
        else:
            queue.append(lid)
    return (holder, queue)


def parse_box_leases(text, claim_re_s, release_re_s):
    """({box: {who, what, since}}, {boxes seen}) from a lease file.

    A box is held when its last CLAIM line has no later RELEASE line.
    Missing groups read as None; unusable regexes or text parse nothing.
    """
    held = {}
    seen = set()
    if not text or not claim_re_s or not release_re_s:
        return (held, seen)
    try:
        claim_re = re.compile(claim_re_s)
    except re.error:
        return (held, seen)
    try:
        release_re = re.compile(release_re_s)
    except re.error:
        return (held, seen)
    last_claim = {}
    last_release = {}
    for i, line in enumerate(str(text).splitlines()):
        m = claim_re.search(line)
        if m is not None:
            gd = m.groupdict()
            b = gd.get("box")
            if b:
                seen.add(b)
                last_claim[b] = (i, {"who": gd.get("who"),
                                     "what": gd.get("what"),
                                     "since": gd.get("at")})
        m2 = release_re.search(line)
        if m2 is not None:
            b2 = m2.groupdict().get("box")
            if b2:
                seen.add(b2)
                last_release[b2] = i
    for b, (i, lease) in last_claim.items():
        if last_release.get(b, -1) < i:
            held[b] = lease
    return (held, seen)


def should_apply_lead_clear(current, kind, seq):
    """True when a lead clear sidecar matches the open needs-lead event.

    The seq guard keeps a stale clear from wiping a newer event raised
    after the lead read state.
    """
    if not isinstance(current, dict):
        return False
    try:
        if int(current.get("seq")) != int(seq):
            return False
    except (TypeError, ValueError):
        return False
    if kind is not None and current.get("kind") != kind:
        return False
    return True


def write_lead_sidecar(ldir, kind, payload):
    """Write lead-<utcstamp>-<n>.json via O_EXCL. Returns the path."""
    stamp = box_ticket_stamp()
    try:
        existing = os.listdir(ldir)
    except OSError:
        existing = []
    n = sum(1 for fn in existing if fn.startswith(LEAD_SIDECAR_PREFIX)) + 1
    body = json.dumps({"kind": kind, "at": now_iso(),
                       "payload": payload if isinstance(payload, dict) else {}}) + "\n"
    for _ in range(100):
        path = os.path.join(ldir, "%s%s-%d%s" % (
            LEAD_SIDECAR_PREFIX, stamp, n, LEAD_SIDECAR_SUFFIX))
        try:
            fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        except FileExistsError:
            n += 1
            continue
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                f.write(body)
        except OSError:
            try:
                os.remove(path)
            except OSError:
                pass
            raise
        _chmod_0600(path)
        return path
    raise OSError("cannot allocate lead sidecar name in %s" % ldir)


def _last_nonblank_line(text):
    for ln in reversed(str(text or "").splitlines()):
        if ln.strip():
            return ln.strip()
    return ""


def format_advisor_error(rc, err_text, out_text, secrets=None):
    """'exit <rc>: <last line>' for a failed advisor call.

    Prefers the last stderr line, falls back to stdout; redacted and
    capped at ADVISOR_ERROR_CAP chars.
    """
    line = _last_nonblank_line(err_text) or _last_nonblank_line(out_text)
    if rc is None:
        base = "exit ?"
    else:
        try:
            base = "exit %d" % int(rc)
        except (TypeError, ValueError):
            base = "exit %s" % rc
    s = base if not line else "%s: %s" % (base, line)
    return redact_text(s, secrets or [])[:ADVISOR_ERROR_CAP]


def now_iso():
    return datetime.datetime.now(datetime.timezone.utc).isoformat()


def is_alive(pid):
    if pid is None:
        return False
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return False
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except OSError:
        return False


def slugify(label):
    s = (label or "").lower()
    s = re.sub(r"[^a-z0-9]+", "-", s)
    s = re.sub(r"-+", "-", s).strip("-")
    if not s:
        return "lane"
    s = s[:32].strip("-")
    return s or "lane"


def default_lane_id(label):
    ts = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    return "%s-%s" % (ts, slugify(label) if label else "lane")


def _chmod_0600(path):
    try:
        os.chmod(path, 0o600)
    except OSError:
        pass


def _ensure_lane_perms(ldir):
    try:
        os.chmod(ldir, 0o700)
    except OSError:
        pass


def atomic_write_bytes(path, data):
    d = os.path.dirname(os.path.abspath(path))
    try:
        os.makedirs(d, exist_ok=True)
    except OSError:
        pass
    tmp = "%s.tmp.%d.%d" % (path, os.getpid(), time.time_ns())
    with open(tmp, "wb") as f:
        f.write(data)
    _chmod_0600(tmp)
    os.replace(tmp, path)
    _chmod_0600(path)


def atomic_write_text(path, text):
    if not isinstance(text, str):
        text = str(text)
    atomic_write_bytes(path, text.encode("utf-8"))


def atomic_write_json(path, obj):
    atomic_write_text(path, json.dumps(obj, indent=2, ensure_ascii=False) + "\n")


def load_json(path, default=None):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            return json.load(f)
    except (FileNotFoundError, OSError, ValueError):
        return default


def parse_env_file(path):
    env = {}
    if not path:
        return env
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            for raw in f:
                line = raw.strip()
                if not line or line.startswith("#"):
                    continue
                if line.startswith("export") and (len(line) > 6 and line[6] in (" ", "\t")):
                    line = line[6:].lstrip()
                if "=" not in line:
                    continue
                k, v = line.split("=", 1)
                k = k.strip()
                v = v.strip()
                if not k:
                    continue
                if len(v) >= 2 and ((v[0] == '"' and v[-1] == '"') or (v[0] == "'" and v[-1] == "'")):
                    v = v[1:-1]
                env[k] = v
    except (FileNotFoundError, OSError):
        return {}
    return env


def secrets_from_env_file(env_file):
    if not env_file:
        return []
    d = parse_env_file(env_file)
    vals = [v for v in d.values() if v and len(v) >= MIN_SECRET_LEN]
    vals.sort(key=len, reverse=True)
    return vals


def union_secrets(a, b):
    merged = set(a or []) | set(b or [])
    vals = [v for v in merged if v and len(v) >= MIN_SECRET_LEN]
    vals.sort(key=len, reverse=True)
    return vals


def redact_text(text, secrets):
    if not text or not secrets:
        return text
    if not isinstance(text, str):
        text = str(text)
    for s in secrets:
        if not s or len(s) < MIN_SECRET_LEN:
            continue
        if s in text:
            text = text.replace(s, "***")
    return text


def redact_json_value(obj, secrets):
    if not secrets:
        return obj
    if isinstance(obj, str):
        return redact_text(obj, secrets)
    if isinstance(obj, list):
        return [redact_json_value(v, secrets) for v in obj]
    if isinstance(obj, dict):
        return {k: redact_json_value(v, secrets) for k, v in obj.items()}
    return obj


def _redact_json_file(path, secrets):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            content = f.read()
    except (FileNotFoundError, OSError):
        return
    if not content.strip():
        return
    try:
        obj = json.loads(content)
    except ValueError:
        red = redact_text(content, secrets)
        if red != content:
            try:
                atomic_write_text(path, red)
            except OSError:
                pass
        return
    red_obj = redact_json_value(obj, secrets)
    try:
        atomic_write_text(path, json.dumps(red_obj, indent=2, ensure_ascii=False) + "\n")
    except OSError:
        pass


def _redact_jsonl_file(path, secrets):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            lines = f.read().splitlines()
    except (FileNotFoundError, OSError):
        return
    out = []
    changed = False
    for line in lines:
        s = line.strip()
        if not s:
            out.append(line)
            continue
        try:
            obj = json.loads(s)
        except ValueError:
            red = redact_text(line, secrets)
            if red != line:
                changed = True
            out.append(red)
            continue
        red_obj = redact_json_value(obj, secrets)
        dumped = json.dumps(red_obj, ensure_ascii=False)
        if dumped != line:
            # JSON dump normalises whitespace; only flag changed when the
            # redacted value differs semantically.
            if red_obj != obj:
                changed = True
        out.append(dumped)
    if changed:
        try:
            atomic_write_text(path, "\n".join(out) + ("\n" if out else ""))
        except OSError:
            pass


def redact_file_inplace(path, secrets):
    if not secrets:
        return
    base = os.path.basename(path)
    if base.endswith(".json"):
        _redact_json_file(path, secrets)
        return
    if base.endswith(".jsonl"):
        _redact_jsonl_file(path, secrets)
        return
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            content = f.read()
    except (FileNotFoundError, OSError):
        return
    red = redact_text(content, secrets)
    if red != content:
        try:
            atomic_write_text(path, red)
        except OSError:
            pass


def redact_sweep_ldir(ldir, secrets):
    """Redact every lane file in place, except briefs and lane.json."""
    if not secrets:
        return
    try:
        names = os.listdir(ldir)
    except OSError:
        return
    for fname in names:
        if fname.startswith("brief"):
            continue
        if fname in ("lane.json",):
            continue
        fp = os.path.join(ldir, fname)
        if not os.path.isfile(fp):
            continue
        redact_file_inplace(fp, secrets)


def lock_path_for_lane(ldir):
    return os.path.join(ldir, LOCK_NAME)


def supervisor_alive(ldir):
    """True when a supervisor currently holds the lane's flock."""
    lp = lock_path_for_lane(ldir)
    try:
        fd = os.open(lp, os.O_RDWR | os.O_CREAT, 0o600)
    except OSError:
        return False
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except (BlockingIOError, OSError) as e:
            if isinstance(e, OSError) and e.errno not in (errno.EACCES, errno.EAGAIN):
                return False
            return True
        try:
            fcntl.flock(fd, fcntl.LOCK_UN)
        except OSError:
            pass
        return False
    finally:
        try:
            os.close(fd)
        except OSError:
            pass


def wait_for_supervisor_lock(ldir, timeout_sec=10.0):
    deadline = time.monotonic() + max(0.0, timeout_sec)
    while time.monotonic() < deadline:
        if supervisor_alive(ldir):
            return True
        time.sleep(0.1)
    return supervisor_alive(ldir)


def _ps_env():
    e = dict(os.environ)
    e["LC_ALL"] = "C"
    e["LANG"] = "C"
    return e


def _norm_start_time(s):
    """Normalise a start-time string to one canonical format.

    Applied to ps output and to every fallback, so values recorded by one
    path compare equal with values re-read by another.
    """
    if s is None:
        return None
    if not isinstance(s, str):
        try:
            s = str(s)
        except Exception:
            return None
    s = " ".join(s.split())
    return s or None


def _start_time_fallback(pid):
    """Process start time without exec, for sandboxes where ps is blocked."""
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return None
    if pid <= 0:
        return None
    # Linux: /proc/<pid>/stat field 22 (starttime, clock ticks since boot).
    try:
        with open("/proc/%d/stat" % pid, "r") as f:
            stat_s = f.read()
        rparen = stat_s.rfind(")")
        if rparen != -1:
            fields = stat_s[rparen + 2:].split()
            if len(fields) >= 20:
                return "proc:%s" % fields[19]
    except (FileNotFoundError, OSError, IndexError):
        pass
    except Exception:
        pass
    # macOS: proc_pidinfo(PROC_PIDTBSDINFO).pbi_start (no exec).
    try:
        import ctypes

        class _BSDInfo(ctypes.Structure):
            _fields_ = [
                ("pbi_flags", ctypes.c_uint32),
                ("pbi_status", ctypes.c_uint32),
                ("pbi_xstatus", ctypes.c_uint32),
                ("pbi_pid", ctypes.c_uint32),
                ("pbi_ppid", ctypes.c_uint32),
                ("pbi_uid", ctypes.c_uint32),
                ("pbi_gid", ctypes.c_uint32),
                ("pbi_ruid", ctypes.c_uint32),
                ("pbi_rgid", ctypes.c_uint32),
                ("pbi_svuid", ctypes.c_uint32),
                ("pbi_svgid", ctypes.c_uint32),
                ("rfu_1", ctypes.c_uint32),
                ("pbi_comm", ctypes.c_char * 16),
                ("pbi_name", ctypes.c_char * 32),
                ("pbi_nfiles", ctypes.c_uint32),
                ("pbi_pgid", ctypes.c_uint32),
                ("pbi_pjobc", ctypes.c_uint32),
                ("e_tdev", ctypes.c_uint32),
                ("e_tpgid", ctypes.c_uint32),
                ("pbi_nice", ctypes.c_int32),
                ("pbi_start_tvsec", ctypes.c_uint64),
                ("pbi_start_tvusec", ctypes.c_uint64),
            ]

        try:
            _libproc = ctypes.CDLL("/usr/lib/libproc.dylib", use_errno=True)
        except OSError:
            return None
        info = _BSDInfo()
        ret = _libproc.proc_pidinfo(pid, 3, 0, ctypes.byref(info),
                                    ctypes.sizeof(info))
        if ret != ctypes.sizeof(info) or int(info.pbi_pid) != pid:
            return None
        return "libproc:%d.%06d" % (int(info.pbi_start_tvsec),
                                    int(info.pbi_start_tvusec))
    except Exception:
        return None


def get_start_time(pid):
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return None
    if pid <= 0:
        return None
    try:
        r = subprocess.run(
            ["ps", "-o", "lstart=", "-p", str(pid)],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=10,
            text=True,
            env=_ps_env(),
        )
    except (PermissionError, FileNotFoundError, OSError):
        return _norm_start_time(_start_time_fallback(pid))
    except Exception:
        return None
    if r.returncode != 0:
        return None
    s = (r.stdout or "").strip()
    if s:
        return _norm_start_time(s)
    # ps ran but told us nothing (e.g. sandboxed stub): try fallback.
    return _norm_start_time(_start_time_fallback(pid))


def pid_is_ours(pid, started):
    if pid is None or not started:
        return False
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return False
    if pid <= 0:
        return False
    cur = get_start_time(pid)
    if cur is None:
        return False
    return cur == started


def pid_unverifiable_but_alive(pid, started):
    """True when pid is alive but cannot be checked against `started`.

    That is: the pid is alive and either no start time was recorded or no
    start time can currently be read for it. A live pid whose start time
    reads fine but differs is verifiably NOT ours (False here): pid reuse,
    safe to leave alone.
    """
    if pid is None:
        return False
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return False
    if pid <= 0:
        return False
    if not is_alive(pid):
        return False
    if not started:
        return True
    return get_start_time(pid) is None


def _wait_pid_gone(pid, timeout_sec=10.0):
    deadline = time.monotonic() + max(0.0, timeout_sec)
    while time.monotonic() < deadline:
        if not is_alive(pid):
            return True
        time.sleep(0.1)
    return not is_alive(pid)


def kill_verified_group(pid, started, timeout_sec=10.0):
    """SIGTERM then SIGKILL a pid/pgid only when its start time matches."""
    if not pid_is_ours(pid, started):
        return False
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return False
    try:
        os.killpg(pid, signal.SIGTERM)
    except (ProcessLookupError, PermissionError, OSError):
        pass
    try:
        os.kill(pid, signal.SIGTERM)
    except (ProcessLookupError, PermissionError, OSError):
        pass
    if _wait_pid_gone(pid, timeout_sec=min(5.0, timeout_sec)):
        return True
    if not pid_is_ours(pid, started):
        return True
    try:
        os.killpg(pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError, OSError):
        pass
    try:
        os.kill(pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError, OSError):
        pass
    _wait_pid_gone(pid, timeout_sec=timeout_sec)
    return True


def _git(args, cwd, timeout=10):
    try:
        r = subprocess.run(
            ["git", "--no-optional-locks"] + list(args),
            cwd=cwd,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=timeout,
            text=True,
        )
        return r
    except Exception:
        return None


def get_git_head(cwd):
    r = _git(["rev-parse", "HEAD"], cwd)
    if r is None or r.returncode != 0:
        return None
    h = (r.stdout or "").strip()
    return h or None


def get_git_status_output(cwd):
    r = _git(["status", "--porcelain"], cwd)
    if r is None or r.returncode != 0:
        return None
    return r.stdout or ""


def _git_fields_z(args, cwd, timeout=10):
    """Run git with -z output; NUL-split str fields, or None on failure.

    Bytes decoded as UTF-8 (-z disables the C-style quoting that would
    mangle non-ASCII names in text mode).
    """
    try:
        r = subprocess.run(
            ["git", "--no-optional-locks"] + list(args),
            cwd=cwd,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=timeout,
        )
    except Exception:
        return None
    if r.returncode != 0:
        return None
    try:
        out = (r.stdout or b"").decode("utf-8", "surrogateescape")
    except Exception:
        return None
    return [f for f in out.split("\0") if f != ""]


def _parse_porcelain_z_fields(fields):
    """Paths from `git status --porcelain -z -uall` fields.

    Renames/copies yield BOTH paths (the entry's new path plus the
    orig-path field that follows it).
    """
    paths = []
    items = list(fields or [])
    i = 0
    while i < len(items):
        f = items[i]
        i += 1
        if not isinstance(f, str) or len(f) < 4 or f[2] != " ":
            continue
        if f[3:]:
            paths.append(f[3:])
        if f[0] in ("R", "C") and i < len(items):
            if items[i]:
                paths.append(items[i])
            i += 1
    return paths


def get_git_status_hash(cwd):
    out = get_git_status_output(cwd)
    if out is None:
        return None
    return hashlib.sha1(out.encode("utf-8")).hexdigest()


def get_fingerprint(cwd):
    head = get_git_head(cwd)
    if head is None:
        r = _git(["rev-parse", "--git-dir"], cwd)
        if r is None or r.returncode != 0:
            return None
        sh = get_git_status_hash(cwd) or "nostatus"
        return "nohead:%s" % sh
    sh = get_git_status_hash(cwd)
    if sh is None:
        return head
    return "%s:%s" % (head, sh)


def get_commits_count(cwd, head_start, head):
    if not head_start or not head or head_start == head:
        return 0
    r = _git(["rev-list", "--count", "%s..%s" % (head_start, head)], cwd)
    if r is None or r.returncode != 0:
        return 0
    try:
        return int((r.stdout or "0").strip() or "0")
    except (TypeError, ValueError):
        return 0


def get_last_subject(cwd):
    if not cwd or not os.path.isdir(cwd):
        return None
    r = _git(["log", "-1", "--format=%s"], cwd)
    if r is None or r.returncode != 0:
        return None
    s = (r.stdout or "").strip()
    return s or None


def get_git_branch(cwd):
    if not cwd or not os.path.isdir(cwd):
        return None
    r = _git(["branch", "--show-current"], cwd)
    if r is not None and r.returncode == 0:
        b = (r.stdout or "").strip()
        if b:
            return b
    r2 = _git(["rev-parse", "--abbrev-ref", "HEAD"], cwd)
    if r2 is not None and r2.returncode == 0:
        b2 = (r2.stdout or "").strip()
        if b2 and b2 != "HEAD":
            return b2
    return None


def _is_lane_internal_path(p):
    """True for the supervisor's own .lane/ files (ASK/ANSWER), never violations."""
    return p == ".lane" or p.startswith(".lane/")


def scope_violating_paths(cwd, head_start, scope_globs):
    """Sorted changed paths matching no scope glob. Empty scope skips."""
    if not scope_globs:
        return []
    if not cwd or not os.path.isdir(cwd):
        return []
    changed = set()
    if head_start:
        try:
            head_now = get_git_head(cwd)
        except Exception:
            head_now = None
        if head_now and head_start != head_now:
            fields = _git_fields_z(["diff", "--name-only", "-z",
                                    "%s..%s" % (head_start, head_now)], cwd)
            if fields is not None:
                for p in fields:
                    changed.add(p)
    try:
        zfields = _git_fields_z(["status", "--porcelain", "-z", "-uall"], cwd)
    except Exception:
        zfields = None
    if zfields is None:
        # Not a git repo (or git failed): nothing checkable.
        if not changed:
            return []
    else:
        for p in _parse_porcelain_z_fields(zfields):
            changed.add(p)
    if not changed:
        return []
    bad = []
    for p in changed:
        if _is_lane_internal_path(p):
            continue
        hit = False
        for pat in scope_globs:
            try:
                if fnmatch.fnmatch(p, pat):
                    hit = True
                    break
            except Exception:
                continue
        if not hit:
            bad.append(p)
    return sorted(bad)


def build_evidence(ldir, lane, state, head, commits, branch=None):
    """Evidence dict for a done lane."""
    cwd = (lane or {}).get("cwd") or ""
    if branch is None:
        try:
            branch = get_git_branch(cwd) if cwd else None
        except Exception:
            branch = None
    accept_log_p = os.path.join(ldir, "accept.log")
    accept_log = accept_log_p if os.path.exists(accept_log_p) else ""
    review_files = []
    try:
        for fn in sorted(os.listdir(ldir)):
            if fn.startswith("REVIEW-") and fn.endswith(".md"):
                review_files.append(os.path.join(ldir, fn))
    except OSError:
        pass
    return {
        "branch": branch,
        "head": head,
        "head_start": (state or {}).get("head_start"),
        "commits": int(commits or 0),
        "accept_log": accept_log,
        "review_files": review_files,
        "summary_path": os.path.join(ldir, "summary.md"),
    }


def get_commit_log(cwd, head_start, head, max_lines=40):
    if head_start and head and head_start != head:
        r = _git(["log", "--oneline", "%s..%s" % (head_start, head)], cwd)
    elif head and not head_start:
        r = _git(["log", "--oneline", "-n", str(max_lines)], cwd)
    else:
        return ""
    if r is None or r.returncode != 0:
        return ""
    lines = (r.stdout or "").strip().splitlines()
    return "\n".join(lines[:max_lines])


def _parse_porcelain_paths(status_output):
    paths = []
    if not status_output:
        return paths
    for line in status_output.splitlines():
        if len(line) < 4:
            continue
        rest = line[3:]
        if " -> " in rest:
            rest = rest.split(" -> ", 1)[1]
        rest = rest.strip().strip('"')
        if rest:
            paths.append(rest)
    return paths


def get_dirty_file_stats(cwd, status_output):
    stats = {}
    if not cwd or not os.path.isdir(cwd):
        return stats
    for rel in _parse_porcelain_paths(status_output):
        ap = os.path.join(cwd, rel)
        try:
            st = os.stat(ap)
        except OSError:
            continue
        try:
            stats[rel] = (st.st_mtime_ns, st.st_size)
        except AttributeError:
            stats[rel] = (int(getattr(st, "st_mtime", 0) * 1e9), st.st_size)
    return stats


def _parse_ps_time_to_sec(s):
    s = (s or "").strip()
    if not s:
        return None
    try:
        days = 0
        if "-" in s:
            dpart, s = s.split("-", 1)
            days = int(dpart.strip() or 0)
        parts = s.split(":")
        nums = []
        for p in parts:
            p = p.strip()
            if not p:
                nums.append(0.0)
                continue
            try:
                nums.append(float(p))
            except ValueError:
                return None
        total = 0.0
        mult = 1.0
        for n in reversed(nums):
            total += n * mult
            mult *= 60.0
        total += days * 86400.0
        return total
    except Exception:
        return None


def get_tree_cpu_total(muse_pid):
    """Total CPU seconds for the muse process group and its descendants.

    Walks pid/ppid/pgid/time from muse_pid down, so a child that setsid()s
    out of the group (e.g. a Unity batch run) still counts as activity.
    """
    try:
        muse_pid = int(muse_pid)
    except (TypeError, ValueError):
        return None
    if muse_pid <= 0:
        return None
    try:
        r = subprocess.run(
            ["ps", "-axo", "pid=,ppid=,pgid=,time="],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=10,
            text=True,
            env=_ps_env(),
        )
    except Exception:
        return None
    if r.returncode != 0:
        return None
    rows = []
    children = {}
    for line in (r.stdout or "").splitlines():
        parts = line.split()
        if len(parts) != 4:
            continue
        try:
            pid = int(parts[0])
            ppid = int(parts[1])
            pgid = int(parts[2])
        except ValueError:
            continue
        sec = _parse_ps_time_to_sec(parts[3])
        rows.append((pid, ppid, pgid, sec))
        children.setdefault(ppid, []).append(pid)
    seen = {muse_pid}
    stack = [muse_pid]
    while stack:
        p = stack.pop()
        for c in children.get(p, []):
            if c not in seen:
                seen.add(c)
                stack.append(c)
    total = 0.0
    found = False
    for pid, _ppid, pgid, sec in rows:
        if sec is None:
            continue
        if pgid != muse_pid and pid not in seen:
            continue
        found = True
        total += sec
    if not found:
        return 0.0
    return total


def get_activity_snapshot(cwd, muse_pid):
    snap = {}
    try:
        snap["head"] = get_git_head(cwd) if cwd and os.path.isdir(cwd) else None
    except Exception:
        snap["head"] = None
    try:
        out = get_git_status_output(cwd) if cwd and os.path.isdir(cwd) else None
    except Exception:
        out = None
    snap["status"] = out
    try:
        snap["dirty"] = get_dirty_file_stats(cwd, out) if out is not None else {}
    except Exception:
        snap["dirty"] = {}
    try:
        snap["cpu"] = get_tree_cpu_total(muse_pid) if muse_pid else None
    except Exception:
        snap["cpu"] = None
    return snap


def read_tail_filtered(err_path, max_lines=20):
    try:
        with open(err_path, "r", encoding="utf-8", errors="replace") as f:
            lines = f.read().splitlines()
    except (FileNotFoundError, OSError):
        return []
    out = []
    for ln in lines:
        if "skill omitted" in ln or "was trimmed to fit" in ln:
            continue
        out.append(ln)
    return out[-max_lines:]


def read_last_json_info(jsonl_path):
    try:
        with open(jsonl_path, "r", encoding="utf-8", errors="replace") as f:
            content = f.read()
    except (FileNotFoundError, OSError):
        return (None, None)
    last_type = None
    last_obj = None
    for line in content.splitlines():
        s = line.strip()
        if not s:
            continue
        try:
            obj = json.loads(s)
        except Exception:
            continue
        last_obj = obj
        if isinstance(obj, dict):
            pt = obj.get("payload_type")
            if isinstance(pt, str):
                last_type = pt
    return (last_type, last_obj)


def _is_run_terminal_event(obj):
    if not isinstance(obj, dict):
        return False
    pt = obj.get("payload_type")
    payload = obj.get("payload")
    if not isinstance(payload, dict):
        return False
    kind = payload.get("kind")
    if kind == "run_terminal":
        return True
    if isinstance(pt, str) and pt.startswith("run.terminal."):
        return True
    return False


def get_terminal_verdict(jsonl_path):
    """Scan the whole JSONL; last run_terminal event wins.

    Returns dict with terminal/text/reason/has_event. Accepts both the real
    1.4.2 shape (payload.kind == "run_terminal") and the older fake shape
    (payload_type run.terminal.* with terminal/text but no kind).
    """
    verdict = {"terminal": None, "text": "", "reason": "", "has_event": False,
               "payload_type": None}
    try:
        with open(jsonl_path, "r", encoding="utf-8", errors="replace") as f:
            content = f.read()
    except (FileNotFoundError, OSError):
        return verdict
    for line in content.splitlines():
        s = line.strip()
        if not s:
            continue
        try:
            obj = json.loads(s)
        except Exception:
            continue
        if not _is_run_terminal_event(obj):
            continue
        payload = obj.get("payload") or {}
        term = payload.get("terminal")
        if not isinstance(term, str) or not term:
            # Derive from payload_type suffix when terminal missing.
            pt = obj.get("payload_type")
            if isinstance(pt, str) and pt.startswith("run.terminal."):
                term = pt.split(".")[-1]
            else:
                continue
        text = payload.get("text", "")
        if not isinstance(text, str):
            try:
                text = str(text)
            except Exception:
                text = ""
        reason = payload.get("reason", "") or payload.get("error", "") or payload.get("message", "") or ""
        if not isinstance(reason, str):
            try:
                reason = str(reason)
            except Exception:
                reason = ""
        verdict = {"terminal": term, "text": text, "reason": reason,
                   "has_event": True, "payload_type": obj.get("payload_type")}
    return verdict


def _is_output_delta_event(obj):
    if not isinstance(obj, dict):
        return False
    payload = obj.get("payload")
    if not isinstance(payload, dict):
        return False
    if payload.get("kind") == "run_output_delta":
        return True
    return obj.get("payload_type") == "run.output.delta"


def get_final_text(jsonl_path):
    """Final answer text from a muse exec JSONL.

    muse 1.3 can emit more than one run_terminal event per exec (a stray
    empty run after the real one), so the last terminal text may be empty
    while an earlier one holds the answer. Prefer the last non-blank
    completed terminal text; when every terminal text is blank, fall back
    to the joined run.output.delta stream, which carries the same final
    assistant message. Returns "" when neither has text.
    """
    last_text = ""
    deltas = []
    try:
        with open(jsonl_path, "r", encoding="utf-8", errors="replace") as f:
            content = f.read()
    except (FileNotFoundError, OSError):
        return ""
    for line in content.splitlines():
        s = line.strip()
        if not s:
            continue
        try:
            obj = json.loads(s)
        except Exception:
            continue
        if _is_run_terminal_event(obj):
            payload = obj.get("payload") or {}
            term = payload.get("terminal")
            if not isinstance(term, str) or not term:
                pt = obj.get("payload_type")
                if isinstance(pt, str) and pt.startswith("run.terminal."):
                    term = pt.split(".")[-1]
            if term == "completed":
                text = payload.get("text") or ""
                if not isinstance(text, str):
                    try:
                        text = str(text)
                    except Exception:
                        text = ""
                if text.strip():
                    last_text = text
        elif _is_output_delta_event(obj):
            text = (obj.get("payload") or {}).get("text") or ""
            if isinstance(text, str) and text:
                deltas.append(text)
    if last_text:
        return last_text
    return "".join(deltas)


def check_completion(jsonl_path):
    v = get_terminal_verdict(jsonl_path)
    if v.get("has_event") and v.get("terminal") == "completed":
        return (True, get_final_text(jsonl_path) or "")
    return (False, None)


# Auth needs real HTTP/auth context: a bare 401/403 digit run (a SHA, a row
# count, a test name) or a path containing "Authentication" must not match.
_AUTH_RES = [
    re.compile(r"\b(?:HTTP|status)[^\n]{0,20}\b40[13]\b", re.IGNORECASE),
    re.compile(r"\b401 Unauthorized\b", re.IGNORECASE),
    re.compile(r"\b403 Forbidden\b", re.IGNORECASE),
    re.compile(r"invalid\s+api\s+key", re.IGNORECASE),
    re.compile(r"authentication failed", re.IGNORECASE),
    re.compile(r"not authenticated", re.IGNORECASE),
    re.compile(r"\bunauthorized\b", re.IGNORECASE),
]
_RETRY_HTTP_RE = re.compile(r"\b429\b|\b(?:HTTP|status)[^\n]{0,20}\b5\d\d\b",
                            re.IGNORECASE)
# Network words as whole words only; bare "eof" (a SHA fragment, "end of
# file" prose) must not match — only "unexpected eof".
_NETWORK_RE = re.compile(
    r"\bnetwork\b|\bconnections?\b|\bconnect\b|\beconn\w*\b|\betimedout\b|"
    r"\benotfound\b|\bgetaddrinfo\b|\beai_again\b|\bsockets?\b|\bdns\b|"
    r"\btls\b|\bssl\b|\bbroken pipe\b|\breset by peer\b|\bunexpected eof\b",
    re.IGNORECASE,
)


def _mentions_auth(text):
    if not text:
        return False
    return any(rx.search(text) for rx in _AUTH_RES)


def _mentions_retry_http(text):
    if not text:
        return False
    return bool(_RETRY_HTTP_RE.search(text))


def _mentions_network(text):
    if not text:
        return False
    return bool(_NETWORK_RE.search(text))


def _stderr_tail(stderr_text, max_lines=CLASSIFY_TAIL_LINES):
    return "\n".join((stderr_text or "").splitlines()[-max_lines:])


def classify_failure(terminal, reason_text, stderr_text, exit_code, stalled=False,
                     spawn_failed=False):
    """Return (cls, reason) with cls in {"fatal","retryable","once"}.

    Order: spawn failure, stalled, terminal interrupted/timed_out, auth,
    rate/5xx, network, model failed/cancelled, other. Only the terminal
    reason plus the last 40 stderr lines are matched, never the full file.
    For model failed/cancelled, rate/network context counts only when it is
    in the terminal reason itself.
    """
    reason = reason_text or ""
    tail = _stderr_tail(stderr_text)
    blob = "\n".join([t for t in (reason, tail) if t])
    if spawn_failed:
        return ("fatal", reason.strip() or "spawn failed")
    if stalled:
        return ("retryable", "stalled")
    if terminal in ("interrupted", "timed_out"):
        return ("retryable", reason.strip() or terminal)
    if _mentions_auth(blob):
        base = reason.strip()
        if not base:
            # Keep the first matching tail line as the reason.
            for ln in tail.splitlines():
                if _mentions_auth(ln):
                    base = ln.strip()[:300]
                    break
            base = base or "auth failure"
        return ("fatal", base)
    if terminal in ("failed", "cancelled"):
        if _mentions_retry_http(reason) or _mentions_network(reason):
            return ("retryable", reason.strip() or terminal)
        return ("once", reason.strip() or terminal)
    if _mentions_retry_http(blob) or _mentions_network(blob):
        base = reason.strip()
        if not base:
            for ln in tail.splitlines():
                if _mentions_retry_http(ln) or _mentions_network(ln):
                    base = ln.strip()[:300]
                    break
            base = base or (terminal or "transient error")
        return ("retryable", base)
    if exit_code is not None and exit_code != 0 and not terminal:
        base = reason.strip() or ("exit %s" % exit_code)
        return ("retryable", base)
    if terminal in ("failed", "cancelled"):
        return ("once", reason.strip() or terminal)
    base = reason.strip() or (terminal or ("exit %s" % exit_code if exit_code is not None else "failed"))
    return ("once", base)


def load_lane(lane_id):
    lp = os.path.join(lane_dir(lane_id), "lane.json")
    return load_json(lp, None)


def load_state(lane_id):
    sp = os.path.join(lane_dir(lane_id), "state.json")
    return load_json(sp, None)


def _iso_age_sec(ts):
    """Seconds since an ISO timestamp, or None when unparseable."""
    if not ts:
        return None
    try:
        dt = datetime.datetime.fromisoformat(str(ts))
    except (TypeError, ValueError):
        return None
    try:
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=datetime.timezone.utc)
        now = datetime.datetime.now(datetime.timezone.utc)
        return (now - dt).total_seconds()
    except Exception:
        return None


def display_status(stored_status, supervisor_pid=None, lane_id=None, ldir=None,
                   state=None, lane=None):
    if stored_status not in NON_TERMINAL:
        return stored_status
    if ldir is None and lane_id is not None:
        ldir = lane_dir(lane_id)
    # Liveness by lock, not pid. A fresh queued lane with no supervisor yet
    # is still queued; one older than 30 s with no lock held is orphaned.
    if stored_status == "queued":
        if ldir is None:
            return "queued"
        try:
            alive = supervisor_alive(ldir)
        except Exception:
            return "queued"
        if alive:
            return "queued"
        st = state
        if st is None:
            st = load_json(os.path.join(ldir, "state.json"), {}) or {}
        ln = lane
        if ln is None and lane_id is not None:
            ln = load_lane(lane_id) or {}
        elif ln is None:
            ln = {}
        ts = (st or {}).get("started_at") or (ln or {}).get("created_at")
        age = _iso_age_sec(ts)
        if age is not None and age > QUEUED_ORPHAN_AFTER_SEC:
            return "orphaned"
        return "queued"
    if ldir is not None:
        try:
            alive = supervisor_alive(ldir)
        except Exception:
            alive = is_alive(supervisor_pid)
        if not alive:
            return "orphaned"
        return stored_status
    if not is_alive(supervisor_pid):
        return "orphaned"
    return stored_status


def _sanitize_marker_part(s):
    return re.sub(r"[^A-Za-z0-9_.-]+", "_", str(s))


def orphan_marker_name(state):
    """Marker name for the supervisor incarnation recorded in state."""
    st = state or {}
    pid = st.get("supervisor_pid")
    started = st.get("supervisor_started")
    p = str(pid) if pid is not None else "none"
    s = _sanitize_marker_part(started) if started else "none"
    return "%s%s-%s" % (ORPHAN_MARKER_PREFIX, p, s)


def is_announced(ldir):
    return os.path.exists(os.path.join(ldir, ANNOUNCE_MARKER))


def is_orphan_announced(ldir, state):
    return os.path.exists(os.path.join(ldir, orphan_marker_name(state)))


def list_lane_ids_newest_first():
    root = lanes_root()
    try:
        names = os.listdir(root)
    except FileNotFoundError:
        return []
    infos = []
    for n in names:
        d = os.path.join(root, n)
        if not os.path.isdir(d):
            continue
        lane = load_json(os.path.join(d, "lane.json"), None)
        if lane is None:
            continue
        created = lane.get("created_at") or ""
        infos.append((created, n))
    infos.sort(key=lambda t: t[0], reverse=True)
    return [n for _, n in infos]


def write_summary_file(ldir, final_status, ended_at=None, final_state=None,
                     extra_secrets=None):
    lane = load_json(os.path.join(ldir, "lane.json"), {}) or {}
    history = load_json(os.path.join(ldir, "history.json"), {}) or {}
    state = load_json(os.path.join(ldir, "state.json"), {}) or {}
    if isinstance(final_state, dict):
        merged = dict(state)
        merged.update(final_state)
        state = merged
    secrets = union_secrets(secrets_from_env_file(lane.get("env_file")),
                            extra_secrets)
    steps = len(lane.get("briefs") or [])
    started_at = state.get("started_at") or lane.get("created_at") or (ended_at or now_iso())
    if ended_at is None:
        ended_at = now_iso()
    wall_str = "unknown"
    try:
        s = datetime.datetime.fromisoformat(str(started_at))
        e = datetime.datetime.fromisoformat(str(ended_at))
        if s.tzinfo is None:
            s = s.replace(tzinfo=datetime.timezone.utc)
        if e.tzinfo is None:
            e = e.replace(tzinfo=datetime.timezone.utc)
        wall = (e - s).total_seconds()
        if wall < 0:
            wall = 0
        if wall < 120:
            wall_str = "%.1fs" % wall
        elif wall < 3600:
            wall_str = "%dm %.0fs" % (int(wall // 60), wall % 60)
        else:
            wall_str = "%dh %dm" % (int(wall // 3600), int((wall % 3600) // 60))
    except Exception:
        pass
    cwd = lane.get("cwd") or ""
    head_start = state.get("head_start")
    try:
        head = get_git_head(cwd) if cwd and os.path.isdir(cwd) else state.get("head")
    except Exception:
        head = state.get("head")
    if head is None:
        head = state.get("head")
    try:
        commits = get_commits_count(cwd, head_start, head) if cwd and os.path.isdir(cwd) else int(state.get("commits") or 0)
    except Exception:
        commits = int(state.get("commits") or 0)
    try:
        clog = get_commit_log(cwd, head_start, head, 40) if cwd and os.path.isdir(cwd) else ""
    except Exception:
        clog = ""
    accept_cmd = lane.get("accept")
    accept_exit = state.get("accept_exit")
    lines = []
    lines.append("# Lane %s (%s)" % (lane.get("label") or "", lane.get("id") or os.path.basename(ldir)))
    lines.append("")
    lines.append("Status: %s" % final_status)
    lines.append("ID: %s" % (lane.get("id") or os.path.basename(ldir)))
    lines.append("Label: %s" % (lane.get("label") or ""))
    lines.append("Started: %s" % started_at)
    lines.append("Ended: %s" % ended_at)
    lines.append("Wall time: %s" % wall_str)
    lines.append("Cwd: %s" % cwd)
    lines.append("")
    nl = state.get("needs_lead") if isinstance(state.get("needs_lead"), dict) else None
    ev = state.get("evidence") if isinstance(state.get("evidence"), dict) else None
    if nl is not None:
        lines.append("## NEEDS LEAD")
        lines.append("kind: %s" % (nl.get("kind") or "?"))
        lines.append("detail: %s" % (nl.get("detail") or "(none)"))
        lines.append("seq: %s" % (nl.get("seq") if nl.get("seq") is not None else "?"))
        if nl.get("step") is not None:
            lines.append("step: %s" % nl.get("step"))
        if nl.get("at"):
            lines.append("at: %s" % nl.get("at"))
        lines.append("")
    if final_status == "done":
        lines.append("## READY TO MERGE")
        if ev is not None:
            lines.append("branch: %s" % (ev.get("branch") or "(none)"))
            lines.append("head: %s" % (ev.get("head") or "(none)"))
            lines.append("head_start: %s" % (ev.get("head_start") or "(none)"))
            lines.append("commits: %s" % ev.get("commits", 0))
            lines.append("accept_log: %s" % (ev.get("accept_log") or "(none)"))
            rf = ev.get("review_files") or []
            if rf:
                lines.append("review_files: %s" % ", ".join(rf))
            else:
                lines.append("review_files: (none)")
            lines.append("summary_path: %s" % (ev.get("summary_path") or "(none)"))
        else:
            lines.append("branch: (none)")
            lines.append("head: %s" % (head or "(none)"))
            lines.append("head_start: %s" % (head_start or "(none)"))
            lines.append("commits: %s" % commits)
            lines.append("accept_log: (none)")
            lines.append("review_files: (none)")
            lines.append("summary_path: %s" % os.path.join(ldir, "summary.md"))
        lines.append("")
    lines.append("## Attempts")
    if steps <= 0:
        lines.append("(no steps)")
    for k in range(1, steps + 1):
        h = history.get(str(k)) or history.get(k) or []
        if not h:
            fp = os.path.join(ldir, "step%d-final.md" % k)
            if os.path.exists(fp):
                lines.append("- Step %d: 1 attempt(s) (attempt 1: ok)" % k)
            else:
                lines.append("- Step %d: 0 attempt(s) (not run)" % k)
            continue
        parts = []
        for e in h:
            try:
                n = int(e.get("attempt", "?"))
            except Exception:
                n = "?"
            if e.get("ok"):
                parts.append("attempt %s: ok" % n)
            else:
                xc = e.get("exit")
                term = e.get("terminal")
                cls = e.get("class")
                rsn = e.get("reason") or "failed"
                parts.append("attempt %s: exit %s terminal %s class %s %s" % (
                    n, xc if xc is not None else "?", term or "none",
                    cls or "?", rsn))
        lines.append("- Step %d: %d attempt(s) (%s)" % (k, len(h), "; ".join(parts)))
        for e in h:
            try:
                n = int(e.get("attempt", "?"))
            except Exception:
                n = "?"
            xc = e.get("exit")
            term = e.get("terminal")
            cls = e.get("class")
            rsn = e.get("reason") or ("ok" if e.get("ok") else "failed")
            lines.append("  - step %d attempt %s: exit=%s terminal=%s class=%s reason=%s" % (
                k, n, xc if xc is not None else "-", term or "-",
                cls or ("ok" if e.get("ok") else "-"), rsn))
    # Last 15 redacted stderr lines of the final attempt.
    try:
        fk, fn = None, None
        for k in range(steps, 0, -1):
            h = history.get(str(k)) or history.get(k) or []
            if h:
                try:
                    fn = int(h[-1].get("attempt", len(h)))
                except Exception:
                    fn = len(h)
                fk = k
                break
        if fk is not None and fn is not None:
            ferr = os.path.join(ldir, "step%d-attempt%d.err" % (fk, fn))
            try:
                with open(ferr, "r", encoding="utf-8", errors="replace") as f:
                    err_lines = f.read().splitlines()
                tail15 = err_lines[-15:]
            except (FileNotFoundError, OSError):
                tail15 = []
            lines.append("")
            lines.append("## Final stderr (step %d attempt %d, last %d)" % (fk, fn, len(tail15)))
            if tail15:
                lines.append("```")
                lines.extend(tail15)
                lines.append("```")
            else:
                lines.append("(none)")
    except Exception:
        pass
    lines.append("")
    lines.append("## Commits (%d)" % commits)
    lines.append("head_start: %s" % (head_start or "(none)"))
    lines.append("head: %s" % (head or "(none)"))
    if clog:
        lines.append("```")
        for ln in clog.splitlines()[:40]:
            lines.append(ln)
        lines.append("```")
    else:
        lines.append("(none)")
    lines.append("")
    lines.append("## Acceptance")
    if accept_cmd:
        lines.append("Command: %s" % accept_cmd)
        lines.append("Exit: %s" % (accept_exit if accept_exit is not None else "(none)"))
        try:
            with open(os.path.join(ldir, "accept.log"), "r", encoding="utf-8", errors="replace") as f:
                alog = f.read().splitlines()
            tail = alog[-20:]
        except (FileNotFoundError, OSError):
            tail = []
        if tail:
            lines.append("Last %d line(s):" % len(tail))
            lines.append("```")
            lines.extend(tail)
            lines.append("```")
        else:
            lines.append("(no output)")
    else:
        lines.append("(none)")
    lines.append("")
    box_notes = state.get("box_move_refusals") or []
    if box_notes:
        lines.append("## Box moves")
        for _bn in box_notes:
            lines.append("- %s" % _bn)
        lines.append("")
    rcfg = lane.get("review") or {}
    rrounds = state.get("review_rounds") or []
    rerr = state.get("review_error")
    if rcfg.get("enabled") or rrounds or rerr:
        lines.append("## %s" % REVIEW_HEADING)
        try:
            _fr = rcfg.get("rounds")
            _fr = 1 if _fr is None else int(_fr)
        except (TypeError, ValueError):
            _fr = 1
        lines.append("Fix re-runs allowed: %d" % _fr)
        if rrounds:
            for e in rrounds:
                try:
                    rn = int(e.get("round", "?"))
                except Exception:
                    rn = "?"
                verdict = e.get("verdict") or "?"
                if e.get("overridden"):
                    lines.append("Round %s: %s (%s)" % (rn, verdict, e["overridden"]))
                else:
                    lines.append("Round %s: %s" % (rn, verdict))
                body = ""
                try:
                    with open(os.path.join(ldir, "REVIEW-%s.md" % rn), "r",
                              encoding="utf-8", errors="replace") as f:
                        content = f.read().strip()
                    _, findings = parse_review_verdict(content)
                    body = findings or content
                except (FileNotFoundError, OSError):
                    body = e.get("findings_preview") or ""
                if e.get("error"):
                    lines.append("error: %s" % e.get("error"))
                if body:
                    lines.append("```")
                    lines.extend(body.splitlines())
                    lines.append("```")
                else:
                    lines.append("(no findings)")
        else:
            lines.append("(no rounds ran)")
        if rerr:
            lines.append("review_error: %s" % rerr)
        lines.append("")
    consults = state.get("consults") or []
    if consults:
        lines.append("## Consult")
        for e in consults:
            try:
                ek = int(e.get("step", "?"))
            except Exception:
                ek = "?"
            try:
                en = int(e.get("n", "?"))
            except Exception:
                en = "?"
            helper = e.get("helper") or ("answered" if e.get("answered") else "?")
            by = e.get("by") or ("lead" if helper == "lead" else "muse")
            esc = bool(e.get("escalated"))
            adv_err = e.get("advisor_error") or ""
            tags = "[%s by=%s escalated=%s%s]" % (
                helper, by, esc,
                (" advisor_error=%s" % adv_err) if adv_err else "")
            q = (e.get("question_preview") or "").strip().splitlines()
            q1 = q[0][:160] if q and q[0] else "(empty)"
            lines.append("- Step %s #%s %s: %s" % (ek, en, tags, q1))
        lines.append("")
    for k in range(1, steps + 1):
        lines.append("## Step %d final" % k)
        try:
            with open(os.path.join(ldir, "step%d-final.md" % k), "r", encoding="utf-8", errors="replace") as f:
                final = f.read()
        except (FileNotFoundError, OSError):
            final = "(no final)"
        final = (final or "").rstrip()
        lines.append(final if final else "(empty)")
        lines.append("")
    text = "\n".join(lines)
    text = redact_text(text, secrets)
    atomic_write_text(os.path.join(ldir, "summary.md"), text if text.endswith("\n") else text + "\n")
    return text


def get_control_branches_since(cwd, head_start, max_branches=20, max_commits=10):
    """control/* branches with commits since head_start: [(branch, one-line log)]."""
    if not cwd or not os.path.isdir(cwd):
        return []
    r = _git(["branch", "--list", "control/*", "--format=%(refname:short)"], cwd)
    if r is None or r.returncode != 0:
        return []
    out = []
    for b in (r.stdout or "").splitlines():
        b = b.strip()
        if not b:
            continue
        if head_start:
            r2 = _git(["log", "--oneline", "%s..%s" % (head_start, b),
                       "-n", str(max_commits)], cwd)
        else:
            r2 = _git(["log", "--oneline", "-n", str(max_commits), b], cwd)
        if r2 is None or r2.returncode != 0:
            continue
        log = (r2.stdout or "").strip()
        if log:
            out.append((b, log))
        if len(out) >= max_branches:
            break
    return out


def get_review_diff(cwd, head_start, head):
    """(stat, full_or_None, files) for the lane's diff.

    full is None when the diff exceeds REVIEW_DIFF_CAP; then files holds
    the --name-only list so the reviewer can read them itself.
    """
    if not cwd or not os.path.isdir(cwd):
        return ("(not a git repo)", None, [])
    if head_start and head and head_start != head:
        rng = "%s..%s" % (head_start, head)
        rs = _git(["diff", rng, "--stat"], cwd)
        stat = ((rs.stdout or "").strip() if rs and rs.returncode == 0
                else "(stat unavailable)")
        rf = _git(["diff", rng], cwd)
        full = (rf.stdout or "") if rf and rf.returncode == 0 else ""
        if len(full) > REVIEW_DIFF_CAP:
            rn = _git(["diff", rng, "--name-only"], cwd)
            files = [l.strip() for l in
                     ((rn.stdout or "").splitlines() if rn and rn.returncode == 0 else [])
                     if l.strip()]
            return (stat or "(empty stat)", None, files)
        return (stat or "(empty stat)", full, [])
    if head:
        rs = _git(["show", "--stat", "--oneline", "HEAD"], cwd)
        stat = ((rs.stdout or "").strip() if rs and rs.returncode == 0
                else "(stat unavailable)")
        return (stat + "\n(no head_start baseline; HEAD shown)", None, [])
    return ("(no commits)", None, [])


def get_git_status_tracked(cwd):
    """`git status --porcelain` over tracked files only, or None."""
    if not cwd or not os.path.isdir(cwd):
        return None
    r = _git(["status", "--porcelain", "--untracked-files=no"], cwd)
    if r is None or r.returncode != 0:
        return None
    return r.stdout or ""


def review_changed_paths(cwd, head_before, head_after,
                         status_before, status_after):
    """Sorted tracked paths that changed across a review session."""
    paths = set()

    def _add_porcelain_path(rest):
        for part in rest.split(" -> "):
            p = part.strip().strip('"')
            if p:
                paths.add(p)

    before = set((status_before or "").splitlines())
    after = set((status_after or "").splitlines())
    for ln in (before ^ after):
        if len(ln) < 4:
            continue
        _add_porcelain_path(ln[3:])
    if (head_before or "") != (head_after or "") and cwd and os.path.isdir(cwd):
        if head_before and head_after:
            r = _git(["diff", "--name-only",
                      "%s..%s" % (head_before, head_after)], cwd)
        elif head_after:
            r = _git(["show", "--name-only", "--format=", head_after], cwd)
        else:
            r = None
        if r is not None and r.returncode == 0:
            for ln in (r.stdout or "").splitlines():
                ln = ln.strip()
                if ln:
                    paths.add(ln)
    return sorted(paths)


def build_review_brief(lane_label, lane_id, brief_texts, head_start, head,
                       stat, full, files, accept_cmd, accept_exit, accept_tail,
                       controls, rnd, reviews_total, extra):
    """Review brief text for round rnd (1-based) of reviews_total reviews."""
    L = []
    L.append("# %s — round %d of %d" % (REVIEW_HEADING, rnd, reviews_total))
    L.append("")
    L.append("You are a pre-filter, not the independent review. An Opus lead does the")
    L.append("final independent review after you; your job is to catch issues first so the")
    L.append("lead spends fewer review rounds. Lane %s (%s), working directory is yours." % (
        lane_label or "", lane_id))
    L.append("")
    L.append("## Checks")
    L.append("1. Every requirement in each step brief below is met by the diff; cite the brief line and the diff hunk or file:line.")
    L.append("2. Writes outside the named allowlist (the Reviewer notes below name it when there is one; otherwise outside the areas the briefs describe).")
    L.append("3. Tests that would pass without the change (no failing-before / passing-after evidence).")
    L.append("4. Missing or toothless controls (a control that cannot fail the lane is a finding).")
    L.append("5. Behaviour the acceptance run did not exercise.")
    L.append("")
    if extra:
        L.append("## Reviewer notes (from lead)")
        L.append(extra.strip())
        L.append("")
    for k, txt in enumerate(brief_texts, start=1):
        L.append("## Step %d brief" % k)
        L.append((txt or "(empty)").strip() or "(empty)")
        L.append("")
    L.append("## Diff stat (head_start %s .. HEAD %s)" % (
        (head_start or "(none)")[:12], (head or "(none)")[:12]))
    L.append("```")
    L.append((stat or "(none)").strip() or "(none)")
    L.append("```")
    L.append("")
    if full is not None:
        L.append("## Full diff")
        L.append("```diff")
        L.append(full.strip() or "(empty diff)")
        L.append("```")
        L.append("")
    else:
        L.append("## Diff too large for this brief (%d files); read them yourself" % len(files))
        for f in files[:500]:
            L.append("- %s" % f)
        L.append("Use `git diff <head_start>..HEAD -- <file>` or read the worktree files.")
        L.append("")
    L.append("## Acceptance")
    L.append("Command: %s" % (accept_cmd or "(none)"))
    L.append("Exit: %s" % (accept_exit if accept_exit is not None else "(none)"))
    L.append("Tail:")
    L.append("```")
    L.append((accept_tail or "(no output)").strip() or "(no output)")
    L.append("```")
    L.append("")
    L.append("## Control branches created since head_start")
    if controls:
        for b, log in controls:
            L.append("- %s" % b)
            for ln in log.splitlines()[:10]:
                L.append("  %s" % ln)
    else:
        L.append("(none)")
    L.append("")
    L.append("## Verdict")
    L.append("This session is read-only: do not modify, create, or delete any files.")
    L.append("End your turn with the verdict as your final answer text: its first line must be")
    L.append("exactly PASS or FAIL, then numbered findings (`1. [severity] path:line description`).")
    L.append("Mark each finding blocker, should-fix, or nit. Any blocker or should-fix finding")
    L.append("means FAIL; PASS only when the findings are nits or none. When in doubt, FAIL.")
    L.append("The supervisor records your final answer as `.lane/REVIEW-%d.md` itself." % rnd)
    return "\n".join(L) + "\n"


def parse_review_verdict(text):
    """(verdict, findings) with verdict in {"PASS", "FAIL", None}."""
    if not text or not text.strip():
        return (None, "")
    lines = text.splitlines()
    first = (lines[0] or "").strip().upper()
    if first in ("PASS", "FAIL"):
        return (first, "\n".join(lines[1:]).strip())
    return (None, text.strip())


_REVIEW_FINDING_LINE_RE = re.compile(r"^\s*\d+\s*[.)]\s+")
_REVIEW_SEVERE_RE = re.compile(r"\b(blocker|should-fix)\b", re.IGNORECASE)


def pass_has_severe_findings(findings):
    """True when a numbered finding carries blocker/should-fix severity."""
    for line in (findings or "").splitlines():
        if (_REVIEW_FINDING_LINE_RE.match(line)
                and _REVIEW_SEVERE_RE.search(line)):
            return True
    return False


def spawn_supervisor(lane_id):
    ldir = lane_dir(lane_id)
    log_path = os.path.join(ldir, "supervisor.log")
    try:
        os.makedirs(ldir, exist_ok=True)
        _ensure_lane_perms(ldir)
        logf = open(log_path, "ab")
        try:
            os.fchmod(logf.fileno(), 0o600)
        except OSError:
            pass
    except OSError as e:
        print("muse-lane: cannot open supervisor.log: %s" % e, file=sys.stderr)
        return None
    try:
        p = subprocess.Popen(
            [sys.executable, os.path.abspath(__file__), "_run", lane_id],
            start_new_session=True,
            stdin=subprocess.DEVNULL,
            stdout=logf,
            stderr=subprocess.STDOUT,
            close_fds=True,
        )
    except Exception as e:
        try:
            logf.close()
        except Exception:
            pass
        print("muse-lane: failed to start supervisor: %s" % e, file=sys.stderr)
        return None
    # Parent must not hold the log fd; child has its own dup.
    try:
        logf.close()
    except Exception:
        pass
    return p.pid


def cmd_start(args):
    cwd = os.path.abspath(os.path.expanduser(args.cwd))
    if not os.path.isdir(cwd):
        print("muse-lane: --cwd does not exist or is not a directory: %s" % args.cwd, file=sys.stderr)
        return 1
    briefs = args.briefs or []
    if not briefs:
        print("muse-lane: at least one --brief is required", file=sys.stderr)
        return 1
    for b in briefs:
        if not os.path.isfile(b):
            print("muse-lane: brief not readable: %s" % b, file=sys.stderr)
            return 1
        try:
            with open(b, "r", encoding="utf-8", errors="replace") as f:
                f.read(1)
        except OSError:
            print("muse-lane: brief not readable: %s" % b, file=sys.stderr)
            return 1
    env_file = None
    if args.env_file:
        env_file = os.path.abspath(os.path.expanduser(args.env_file))
        if not os.path.isfile(env_file):
            print("muse-lane: --env-file not readable: %s" % args.env_file, file=sys.stderr)
            return 1
    label = args.label or ""
    cfg, cfg_err = load_effective_config()
    if cfg_err is not None:
        print("muse-lane: %s" % cfg_err, file=sys.stderr)
        return 1
    scope_globs = list(getattr(args, "scope", None) or [])
    for g in scope_globs:
        if not isinstance(g, str) or not g.strip():
            print("muse-lane: invalid --scope (must be a non-empty glob)", file=sys.stderr)
            return 1
    bad_tool = advisor_cmd_forbidden_tool((cfg or {}).get("advisor_cmd"))
    if bad_tool is not None:
        print("muse-lane: advisor_cmd --tools must not include %s (advisor is read-only)" % bad_tool,
              file=sys.stderr)
        return 1
    box_name = getattr(args, "box", None)
    if box_name is not None:
        box_name = str(box_name).strip()
        box_err = box_name_error(box_name)
        if box_err is not None:
            print("muse-lane: invalid --box %r: %s" % (box_name, box_err), file=sys.stderr)
            return 1
    else:
        box_name = None
    root = lanes_root()
    try:
        os.makedirs(root, exist_ok=True)
    except OSError as e:
        print("muse-lane: cannot create lanes root: %s" % e, file=sys.stderr)
        return 1
    lane_id = args.id
    if lane_id:
        if "/" in lane_id or lane_id in (".", "..") or not re.match(r"^[A-Za-z0-9][A-Za-z0-9._-]*$", lane_id):
            print("muse-lane: invalid --id: %s" % lane_id, file=sys.stderr)
            return 1
        if os.path.exists(os.path.join(root, lane_id)):
            print("muse-lane: id already in use: %s" % lane_id, file=sys.stderr)
            return 1
    else:
        base = default_lane_id(label)
        lane_id = base
        i = 2
        while os.path.exists(os.path.join(root, lane_id)):
            lane_id = "%s-%d" % (base, i)
            i += 1
    ldir = os.path.join(root, lane_id)
    try:
        os.makedirs(ldir, mode=0o700, exist_ok=False)
    except OSError as e:
        print("muse-lane: cannot create lane dir: %s" % e, file=sys.stderr)
        return 1
    _ensure_lane_perms(ldir)
    for idx, src in enumerate(briefs, start=1):
        dst = os.path.join(ldir, "brief%d.md" % idx)
        try:
            shutil.copyfile(src, dst)
            _chmod_0600(dst)
        except OSError as e:
            print("muse-lane: cannot copy brief %s: %s" % (src, e), file=sys.stderr)
            return 1
    try:
        stall_min = float(args.stall_min)
    except (TypeError, ValueError):
        print("muse-lane: invalid --stall-min", file=sys.stderr)
        return 1
    stall_sec = stall_min * 60.0
    try:
        _rr = getattr(args, "review_rounds", 1)
        review_rounds = int(1 if _rr is None else _rr)
    except (TypeError, ValueError):
        print("muse-lane: invalid --review-rounds", file=sys.stderr)
        return 1
    if review_rounds < 0:
        print("muse-lane: --review-rounds must be >= 0", file=sys.stderr)
        return 1
    review_extra = None
    if getattr(args, "review_brief", None):
        rb = args.review_brief
        if os.path.isfile(rb):
            try:
                with open(rb, "r", encoding="utf-8", errors="replace") as f:
                    review_extra = f.read()
            except OSError:
                print("muse-lane: --review-brief not readable: %s" % rb, file=sys.stderr)
                return 1
        else:
            review_extra = rb
    review_cfg = None
    if getattr(args, "review", False):
        review_cfg = {"enabled": True, "brief": review_extra, "rounds": review_rounds}
    elif review_extra is not None or getattr(args, "review_rounds", 1) != 1:
        print("muse-lane: --review-brief/--review-rounds need --review", file=sys.stderr)
        return 1
    try:
        _cm = getattr(args, "consult_max", CONSULT_MAX_DEFAULT)
        consult_max = int(CONSULT_MAX_DEFAULT if _cm is None else _cm)
    except (TypeError, ValueError):
        print("muse-lane: invalid --consult-max", file=sys.stderr)
        return 1
    if consult_max < 0:
        print("muse-lane: --consult-max must be >= 0", file=sys.stderr)
        return 1
    try:
        consult_timeout_min = float(getattr(args, "consult_timeout_min", 15.0))
    except (TypeError, ValueError):
        print("muse-lane: invalid --consult-timeout-min", file=sys.stderr)
        return 1
    if consult_timeout_min <= 0:
        print("muse-lane: --consult-timeout-min must be > 0", file=sys.stderr)
        return 1
    advisor_model_raw = getattr(args, "advisor_model", None)
    advisor_max_raw = getattr(args, "advisor_max", None)
    advisor_cfg = None
    if advisor_model_raw is not None or advisor_max_raw is not None:
        _am = advisor_model_raw or ADVISOR_DEFAULT_MODEL
        if _am not in ADVISOR_MODELS:
            print("muse-lane: invalid --advisor-model (sonnet|opus)", file=sys.stderr)
            return 1
        try:
            _ax = ADVISOR_DEFAULT_MAX if advisor_max_raw is None else int(advisor_max_raw)
        except (TypeError, ValueError):
            print("muse-lane: invalid --advisor-max", file=sys.stderr)
            return 1
        if _ax < 0:
            print("muse-lane: --advisor-max must be >= 0", file=sys.stderr)
            return 1
        advisor_cfg = {"model": _am, "max": _ax}
    exec_env = {}
    try:
        exec_env["MUSE_BIN"] = os.environ.get("MUSE_BIN", "") or ""
    except Exception:
        exec_env["MUSE_BIN"] = ""
    try:
        exec_env["CLAUDE_BIN"] = os.environ.get("CLAUDE_BIN", "") or ""
    except Exception:
        exec_env["CLAUDE_BIN"] = ""
    try:
        exec_env["PATH"] = os.environ.get("PATH", "") or ""
    except Exception:
        exec_env["PATH"] = ""
    for k, v in os.environ.items():
        if k.startswith("MUSE_LANE_"):
            try:
                exec_env[k] = v
            except Exception:
                pass
    if consult_max > 0:
        prefix = "\n".join(CONSULT_PREFIX_LINES) + "\n\n"
        for idx in range(1, len(briefs) + 1):
            dst = os.path.join(ldir, "brief%d.md" % idx)
            try:
                with open(dst, "r", encoding="utf-8", errors="replace") as f:
                    cur = f.read()
                atomic_write_text(dst, prefix + cur)
            except OSError as e:
                print("muse-lane: cannot prefix brief %s: %s" % (dst, e), file=sys.stderr)
                return 1
    lane = {
        "id": lane_id,
        "label": label,
        "cwd": cwd,
        "briefs": [os.path.abspath(os.path.expanduser(b)) for b in briefs],
        "accept": args.accept,
        "effort": args.effort or "max",
        "env_file": env_file,
        "accept_env": bool(getattr(args, "accept_env", False)),
        "stall_sec": stall_sec,
        "created_at": now_iso(),
        "exec_env": exec_env,
        "owner_session": getattr(args, "owner_session", None),
        "review": review_cfg,
        "consult_max": consult_max,
        "consult_timeout_sec": consult_timeout_min * 60.0,
        "scope": scope_globs,
        "box": box_name,
        "config": cfg,
        "advisor": advisor_cfg,
    }
    atomic_write_json(os.path.join(ldir, "lane.json"), lane)
    # Write queued state before spawning so stop/status never see a gap.
    created = lane.get("created_at")
    try:
        head_start = get_git_head(cwd) if os.path.isdir(cwd) else None
    except Exception:
        head_start = None
    queued_state = {
        "status": "queued",
        "step": 1,
        "steps": len(briefs),
        "attempt": 1,
        "supervisor_pid": None,
        "supervisor_started": None,
        "muse_pid": None,
        "muse_started": None,
        "accept_pid": None,
        "accept_started": None,
        "started_at": created,
        "updated_at": created,
        "last_activity_at": created,
        "last_event": None,
        "head_start": head_start,
        "head": head_start,
        "commits": 0,
        "stderr_tail": "",
        "accept_exit": None,
        "retry_at": None,
        "reason": None,
        "phase": None,
        "phase_started": None,
        "review_rounds": [],
        "review_error": None,
        "consults": [],
        "needs_lead": None,
        "needs_lead_seq": 0,
        "box_state": None,
        "box_queued_at": None,
        "box_move_refusals": [],
        "evidence": None,
        "advisor_calls": 0,
    }
    atomic_write_json(os.path.join(ldir, "state.json"), queued_state)
    pid = spawn_supervisor(lane_id)
    if pid is None:
        return 1
    print(lane_id)
    return 0


def _default_queued_state(lane):
    return {
        "status": "queued",
        "step": 1,
        "steps": len(lane.get("briefs") or []),
        "attempt": 1,
        "supervisor_pid": None,
        "supervisor_started": None,
        "muse_pid": None,
        "muse_started": None,
        "accept_pid": None,
        "accept_started": None,
        "started_at": lane.get("created_at"),
        "updated_at": lane.get("created_at"),
        "last_activity_at": lane.get("created_at"),
        "last_event": None,
        "head_start": None,
        "head": None,
        "commits": 0,
        "stderr_tail": "",
        "accept_exit": None,
        "retry_at": None,
        "reason": None,
        "phase": None,
        "phase_started": None,
        "review_rounds": [],
        "review_error": None,
        "consults": [],
        "needs_lead": None,
        "needs_lead_seq": 0,
        "box_state": None,
        "box_queued_at": None,
        "box_move_refusals": [],
        "evidence": None,
        "advisor_calls": 0,
    }


def _cheap_status_view(lid):
    """Lane + state + display status from JSON and a lock probe only.

    No subprocesses, no log reads: cheap enough to run for every lane ever
    so --active/--limit can shed lanes before any per-lane work.
    Returns (lane, state, disp) or None when the lane has no lane.json.
    """
    lane = load_lane(lid)
    if lane is None:
        return None
    state = load_state(lid)
    if state is None:
        state = _default_queued_state(lane)
        disp = "queued"
    else:
        disp = display_status(state.get("status"), state.get("supervisor_pid"),
                              lane_id=lid, state=state, lane=lane)
    return (lane, state, disp)


def _is_live_display_status(disp):
    return disp in NON_TERMINAL or disp == "orphaned"


def _build_status_obj(lid, lane, state, disp):
    ldir = lane_dir(lid)
    obj = dict(state)
    # Old state files lack review/phase fields; read them unchanged.
    obj.setdefault("phase", None)
    obj.setdefault("phase_started", None)
    obj.setdefault("review_rounds", [])
    obj.setdefault("review_error", None)
    obj.setdefault("consults", [])
    obj.setdefault("needs_lead", None)
    obj.setdefault("needs_lead_seq", 0)
    obj.setdefault("box_state", None)
    obj.setdefault("box_queued_at", None)
    obj.setdefault("box_move_refusals", [])
    obj.setdefault("evidence", None)
    obj.setdefault("advisor_calls", 0)
    try:
        obj["advisor_calls"] = int(obj.get("advisor_calls") or 0)
    except (TypeError, ValueError):
        obj["advisor_calls"] = 0
    obj["id"] = lid
    obj["label"] = lane.get("label") or ""
    obj["cwd"] = lane.get("cwd") or ""
    obj["status"] = disp
    obj["owner_session"] = lane.get("owner_session")
    obj["announced"] = is_announced(ldir)
    obj["orphan_announced"] = is_orphan_announced(ldir, state)
    obj["stall_sec"] = lane.get("stall_sec")
    nl = obj.get("needs_lead")
    seq = nl.get("seq") if isinstance(nl, dict) else None
    obj["needs_lead_announced"] = is_lead_announced(ldir, seq)
    obj["box"] = lane.get("box")
    # Branch/head live-only: ended lanes run no git at all.
    if _is_live_display_status(disp):
        cwd = lane.get("cwd") or ""
        try:
            obj["branch"] = get_git_branch(cwd)
        except Exception:
            obj["branch"] = None
        try:
            fresh_head = get_git_head(cwd)
        except Exception:
            fresh_head = None
        obj["head"] = fresh_head if fresh_head is not None else state.get("head")
        try:
            obj["last_subject"] = get_last_subject(cwd)
        except Exception:
            obj["last_subject"] = None
    else:
        obj["branch"] = None
        obj["head"] = state.get("head")
        obj["last_subject"] = None
    try:
        with open(os.path.join(ldir, "accept.log"), "r", encoding="utf-8", errors="replace") as f:
            obj["accept_tail"] = "\n".join(f.read().splitlines()[-5:])
    except (FileNotFoundError, OSError):
        obj["accept_tail"] = ""
    # Redact anything printable using this lane's secrets.
    secrets = secrets_from_env_file(lane.get("env_file"))
    if secrets:
        for k, v in list(obj.items()):
            if isinstance(v, str):
                obj[k] = redact_text(v, secrets)
    return obj


def cmd_status(args):
    want_id = getattr(args, "id", None)
    as_json = bool(getattr(args, "json", False))
    if want_id:
        ids = [want_id]
        lane = load_lane(want_id)
        if lane is None:
            print("muse-lane: unknown lane: %s" % want_id, file=sys.stderr)
            return 1
    else:
        ids = list_lane_ids_newest_first()
    views = []
    for lid in ids:
        v = _cheap_status_view(lid)
        if v is None:
            continue
        lane, state, disp = v
        views.append((lid, lane, state, disp))
    total = len(views)
    if not want_id and bool(getattr(args, "active", False)):
        kept = []
        for (lid, lane, state, disp) in views:
            if _is_live_display_status(disp):
                kept.append((lid, lane, state, disp))
                continue
            age = _iso_age_sec(state.get("updated_at"))
            if age is None or age <= 24 * 3600:
                kept.append((lid, lane, state, disp))
        views = kept
    limit = getattr(args, "limit", None)
    if not want_id and limit is not None:
        try:
            views = views[:max(0, int(limit))]
        except (TypeError, ValueError):
            pass
    objs = [_build_status_obj(lid, lane, state, disp)
            for (lid, lane, state, disp) in views]
    older = total - len(objs)
    if as_json:
        print(json.dumps(objs, indent=2))
        return 0
    if want_id:
        o = objs[0] if objs else {}
        print("id: %s" % o.get("id", want_id))
        print("label: %s" % o.get("label", ""))
        print("cwd: %s" % o.get("cwd", ""))
        print("status: %s" % o.get("status", "?"))
        print("step: %s/%s attempt: %s" % (o.get("step"), o.get("steps"), o.get("attempt")))
        print("supervisor_pid: %s muse_pid: %s" % (o.get("supervisor_pid"), o.get("muse_pid")))
        print("owner_session: %s announced: %s orphan_announced: %s" % (
            o.get("owner_session"), o.get("announced"), o.get("orphan_announced")))
        print("started: %s updated: %s" % (o.get("started_at"), o.get("updated_at")))
        print("last_activity: %s last_event: %s" % (o.get("last_activity_at"), o.get("last_event")))
        print("head_start: %s head: %s commits: %s" % (o.get("head_start"), o.get("head"), o.get("commits")))
        print("accept_exit: %s retry_at: %s reason: %s" % (o.get("accept_exit"), o.get("retry_at"), o.get("reason")))
        print("phase: %s since %s" % (o.get("phase"), o.get("phase_started")))
        rr = o.get("review_rounds") or []
        if rr:
            print("review: %s" % ", ".join(
                "r%s=%s" % (e.get("round"), e.get("verdict")) for e in rr if isinstance(e, dict)))
        if o.get("review_error"):
            print("review_error: %s" % o.get("review_error"))
        tail = o.get("stderr_tail") or ""
        if tail:
            print("stderr_tail:")
            for ln in str(tail).splitlines()[-20:]:
                print("  %s" % ln)
        return 0
    if not objs:
        if older > 0:
            print("(no lanes match; +%d older not shown)" % older)
        else:
            print("(no lanes)")
        return 0
    for o in objs:
        print("%s  %s  step %s/%s att %s  updated %s  %s" % (
            o.get("id"), o.get("status"), o.get("step"), o.get("steps"),
            o.get("attempt"), o.get("updated_at"), o.get("reason") or "",
        ))
    if older > 0:
        print("(+%d older lanes not shown)" % older)
    return 0


def _kill_pgid(pgid, sig):
    try:
        pgid = int(pgid)
    except (TypeError, ValueError):
        return False
    if pgid <= 0:
        return False
    try:
        os.killpg(pgid, sig)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except OSError:
        return False


def _kill_pid(pid, sig):
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return False
    if pid <= 0:
        return False
    try:
        os.kill(pid, sig)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except OSError:
        return False


def _kill_verified_orphans(state):
    st = state or {}
    for pid_key, started_key in (("muse_pid", "muse_started"),
                                 ("accept_pid", "accept_started")):
        try:
            kill_verified_group(st.get(pid_key), st.get(started_key), timeout_sec=10.0)
        except Exception:
            pass


def _build_stopped_state(lane, state):
    state = state or {}
    lane = lane or {}
    secrets = secrets_from_env_file(lane.get("env_file"))
    cwd = lane.get("cwd") or ""
    try:
        head = get_git_head(cwd) if cwd and os.path.isdir(cwd) else state.get("head")
    except Exception:
        head = state.get("head")
    try:
        commits = get_commits_count(cwd, state.get("head_start"), head) if cwd and os.path.isdir(cwd) else int(state.get("commits") or 0)
    except Exception:
        commits = int(state.get("commits") or 0)
    ended = now_iso()
    try:
        _seq = int(state.get("needs_lead_seq") or 0)
    except (TypeError, ValueError):
        _seq = 0
    try:
        _ac = int(state.get("advisor_calls") or 0)
    except (TypeError, ValueError):
        _ac = 0
    new_state = {
        "status": "stopped",
        "step": int(state.get("step") or 1),
        "steps": len(lane.get("briefs") or []) or int(state.get("steps") or 1),
        "attempt": int(state.get("attempt") or 1),
        "supervisor_pid": state.get("supervisor_pid"),
        "supervisor_started": state.get("supervisor_started"),
        "muse_pid": None,
        "muse_started": None,
        "accept_pid": None,
        "accept_started": None,
        "started_at": state.get("started_at") or lane.get("created_at") or ended,
        "updated_at": ended,
        "last_activity_at": state.get("last_activity_at") or ended,
        "last_event": state.get("last_event"),
        "head_start": state.get("head_start"),
        "head": head,
        "commits": commits,
        "stderr_tail": state.get("stderr_tail") or "",
        "accept_exit": state.get("accept_exit"),
        "retry_at": None,
        "reason": "stopped",
        "phase": state.get("phase"),
        "phase_started": state.get("phase_started"),
        "review_rounds": state.get("review_rounds") or [],
        "review_error": state.get("review_error"),
        "consults": state.get("consults") or [],
        "needs_lead": state.get("needs_lead"),
        "needs_lead_seq": _seq,
        "box_state": state.get("box_state"),
        "box_queued_at": state.get("box_queued_at"),
        "box_move_refusals": state.get("box_move_refusals") or [],
        "evidence": None,
        "advisor_calls": _ac,
    }
    for k, v in list(new_state.items()):
        if isinstance(v, str):
            new_state[k] = redact_text(v, secrets)
    return new_state, ended


def _wait_lock_released(ldir, timeout_sec):
    deadline = time.monotonic() + max(0.0, timeout_sec)
    while time.monotonic() < deadline:
        try:
            if not supervisor_alive(ldir):
                return True
        except Exception:
            return True
        time.sleep(0.2)
    try:
        return not supervisor_alive(ldir)
    except Exception:
        return True


def cmd_stop(args):
    lane_id = args.id
    ldir = lane_dir(lane_id)
    lane = load_lane(lane_id)
    if lane is None:
        print("muse-lane: unknown lane: %s" % lane_id, file=sys.stderr)
        return 1
    state = load_state(lane_id)
    if state is not None and state.get("status") in TERMINAL:
        print("%s already %s" % (lane_id, state.get("status")))
        return 0
    live = False
    try:
        live = supervisor_alive(ldir)
    except Exception:
        live = is_alive((state or {}).get("supervisor_pid"))
    sup_pid = (state or {}).get("supervisor_pid") if state else None
    sup_started = (state or {}).get("supervisor_started") if state else None
    if live:
        # Marker FIRST, so any supervisor — even one we cannot safely
        # signal — stops itself on its next check.
        try:
            atomic_write_text(os.path.join(ldir, STOP_MARKER), now_iso() + "\n")
        except OSError:
            pass
        # Signal only a supervisor verified by pid + recorded start time.
        if pid_is_ours(sup_pid, sup_started):
            _kill_pgid(sup_pid, signal.SIGTERM)
            _kill_pid(sup_pid, signal.SIGTERM)
            _wait_lock_released(ldir, 10.0)
            # Escalate once if the lock is still held, re-verifying first.
            try:
                still_live = supervisor_alive(ldir)
            except Exception:
                still_live = is_alive(sup_pid)
            if still_live and pid_is_ours(sup_pid, sup_started):
                _kill_pgid(sup_pid, signal.SIGKILL)
                _kill_pid(sup_pid, signal.SIGKILL)
                _wait_lock_released(ldir, 5.0)
        else:
            # Unverified pid: never signal it; wait for the marker-driven
            # exit instead.
            _wait_lock_released(ldir, 15.0)
        # Re-read; supervisor may have written stopped itself.
        state = load_state(lane_id) or state or {}
        if state.get("status") in TERMINAL:
            # Ensure a summary exists for the terminal state.
            sp = os.path.join(ldir, "summary.md")
            if not os.path.exists(sp):
                try:
                    write_summary_file(ldir, state.get("status"), state.get("updated_at"))
                except Exception as e:
                    print("muse-lane: failed to write summary: %s" % e, file=sys.stderr)
            print("%s stopped" % lane_id)
            return 0
        try:
            still_live = supervisor_alive(ldir)
        except Exception:
            still_live = False
        if still_live:
            print("muse-lane: supervisor still alive; stop not completed",
                  file=sys.stderr)
            return 1
        # Supervisor is gone but left non-terminal state: kill verified
        # orphans, then write summary BEFORE stopped state, then sweep.
        _kill_verified_orphans(state)
        new_state, ended = _build_stopped_state(lane, state)
        try:
            write_summary_file(ldir, "stopped", ended, final_state=new_state)
        except Exception as e:
            print("muse-lane: failed to write summary: %s" % e, file=sys.stderr)
        atomic_write_json(os.path.join(ldir, "state.json"), new_state)
        redact_sweep_ldir(ldir, secrets_from_env_file(lane.get("env_file")))
        print("%s stopped" % lane_id)
        return 0
    # No live supervisor: kill verified orphans, write marker + stopped,
    # then run the same final redaction sweep as a normal end.
    _kill_verified_orphans(state)
    new_state, ended = _build_stopped_state(lane, state)
    try:
        atomic_write_text(os.path.join(ldir, STOP_MARKER), ended + "\n")
    except OSError:
        pass
    try:
        write_summary_file(ldir, "stopped", ended, final_state=new_state)
    except Exception as e:
        print("muse-lane: failed to write summary: %s" % e, file=sys.stderr)
    atomic_write_json(os.path.join(ldir, "state.json"), new_state)
    redact_sweep_ldir(ldir, secrets_from_env_file(lane.get("env_file")))
    print("%s stopped" % lane_id)
    return 0


def cmd_resume(args):
    lane_id = args.id
    ldir = lane_dir(lane_id)
    lane = load_lane(lane_id)
    if lane is None:
        print("muse-lane: unknown lane: %s" % lane_id, file=sys.stderr)
        return 1
    state = load_state(lane_id)
    if state is None:
        print("muse-lane: lane has no state (nothing to resume): %s" % lane_id, file=sys.stderr)
        return 1
    stored = state.get("status")
    if stored in TERMINAL:
        print("muse-lane: lane is %s, not orphaned" % stored, file=sys.stderr)
        return 1
    try:
        live = supervisor_alive(ldir)
    except Exception:
        live = is_alive(state.get("supervisor_pid"))
    if live:
        print("muse-lane: supervisor still alive; not orphaned", file=sys.stderr)
        return 1
    # Refuse while a recorded child is alive but its start time cannot be
    # verified: never start a second muse beside an unverifiable live one.
    for pid_key, started_key in (("muse_pid", "muse_started"),
                                 ("accept_pid", "accept_started")):
        if pid_unverifiable_but_alive(state.get(pid_key), state.get(started_key)):
            print("muse-lane: refusing resume: recorded %s %s is alive but "
                  "its start time cannot be verified" % (pid_key, state.get(pid_key)),
                  file=sys.stderr)
            return 1
    # Kill still-live orphaned children (verified by start time) and wait
    # for them to exit before anything new starts.
    _kill_verified_orphans(state)
    # A previous stop request must not kill the resumed run.
    try:
        mp = os.path.join(ldir, STOP_MARKER)
        if os.path.exists(mp):
            os.remove(mp)
    except OSError:
        pass
    pid = spawn_supervisor(lane_id)
    if pid is None:
        return 1
    if not wait_for_supervisor_lock(ldir, timeout_sec=10.0):
        print("muse-lane: supervisor did not take the lock in 10s", file=sys.stderr)
        return 1
    print(lane_id)
    return 0


def cmd_summary(args):
    lane_id = args.id
    ldir = lane_dir(lane_id)
    lane = load_lane(lane_id)
    if lane is None:
        print("muse-lane: unknown lane: %s" % lane_id, file=sys.stderr)
        return 1
    sp = os.path.join(ldir, "summary.md")
    try:
        with open(sp, "r", encoding="utf-8", errors="replace") as f:
            text = f.read()
    except FileNotFoundError:
        print("muse-lane: no summary yet for %s" % lane_id, file=sys.stderr)
        return 1
    secrets = secrets_from_env_file(lane.get("env_file"))
    print(redact_text(text, secrets), end="" if text.endswith("\n") else "\n")
    return 0


def cmd_ack(args):
    lane_id = args.id
    ldir = lane_dir(lane_id)
    lane = load_lane(lane_id)
    if lane is None:
        print("muse-lane: unknown lane: %s" % lane_id, file=sys.stderr)
        return 1
    state = load_state(lane_id)
    if state is None:
        print("muse-lane: lane has no state: %s" % lane_id, file=sys.stderr)
        return 1
    want_orphan = bool(getattr(args, "orphan", False))
    want_lead = getattr(args, "lead", None)
    if want_orphan and want_lead is not None:
        print("muse-lane: cannot combine --orphan and --lead", file=sys.stderr)
        return 1
    if want_lead is not None:
        try:
            want_seq = int(want_lead)
        except (TypeError, ValueError):
            print("muse-lane: invalid --lead seq: %r" % (want_lead,), file=sys.stderr)
            return 1
        nl = state.get("needs_lead") if isinstance(state.get("needs_lead"), dict) else None
        cur = None
        if nl is not None:
            try:
                cur = int(nl.get("seq"))
            except (TypeError, ValueError):
                cur = None
        if nl is None or cur != want_seq:
            print("muse-lane: lane has no needs-lead seq %s" % want_seq, file=sys.stderr)
            return 2
        marker = lead_marker_name(want_seq)
    elif want_orphan:
        disp = display_status(state.get("status"), state.get("supervisor_pid"),
                              lane_id=lane_id, state=state, lane=lane)
        if disp != "orphaned":
            print("muse-lane: lane is %s, not orphaned" % disp, file=sys.stderr)
            return 2
        marker = orphan_marker_name(state)
    else:
        if state.get("status") not in TERMINAL:
            print("muse-lane: lane is %s, not terminal" % state.get("status"),
                  file=sys.stderr)
            return 2
        marker = ANNOUNCE_MARKER
    path = os.path.join(ldir, marker)
    try:
        fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
    except FileExistsError:
        return ACK_EXISTS_EXIT
    except OSError as e:
        print("muse-lane: cannot create ack marker: %s" % e, file=sys.stderr)
        return 1
    try:
        with os.fdopen(fd, "w", encoding="utf-8", errors="replace") as f:
            f.write("%s pid=%d\n" % (now_iso(), os.getpid()))
    except OSError:
        pass
    _chmod_0600(path)
    return 0


def _max_consult_n(entries):
    m = 0
    for e in entries or []:
        try:
            m = max(m, int(e.get("n") or 0))
        except (TypeError, ValueError):
            pass
    return m


def _consult_next_n(state, cwd):
    m = 0
    for e in (state or {}).get("consults") or []:
        try:
            m = max(m, int(e.get("n") or 0))
        except (TypeError, ValueError):
            pass
    try:
        for fn in os.listdir(os.path.join(cwd, ".lane")):
            if fn.startswith("ASK-") and fn.endswith(".md"):
                try:
                    m = max(m, int(fn[4:-3]))
                except ValueError:
                    pass
    except OSError:
        pass
    return m + 1


def cmd_answer(args):
    lane_id = args.id
    ldir = lane_dir(lane_id)
    lane = load_lane(lane_id)
    if lane is None:
        print("muse-lane: unknown lane: %s" % lane_id, file=sys.stderr)
        return 1
    state = load_state(lane_id)
    if state is None:
        print("muse-lane: lane has no state: %s" % lane_id, file=sys.stderr)
        return 1
    if state.get("status") in TERMINAL:
        print("muse-lane: lane is %s, cannot answer an ended lane" % state.get("status"),
              file=sys.stderr)
        return 1
    text = getattr(args, "text", None)
    text_file = getattr(args, "text_file", None)
    if text is not None and text_file is not None:
        print("muse-lane: cannot combine --text and --text-file", file=sys.stderr)
        return 1
    if text_file is not None:
        try:
            with open(os.path.abspath(os.path.expanduser(text_file)), "r",
                      encoding="utf-8", errors="replace") as f:
                text = f.read()
        except OSError as e:
            print("muse-lane: --text-file not readable: %s" % e, file=sys.stderr)
            return 1
    box_b = getattr(args, "box", None)
    if box_b is not None:
        box_b = str(box_b).strip()
        box_err = box_name_error(box_b)
        if box_err is not None:
            print("muse-lane: invalid --box %r: %s" % (box_b, box_err), file=sys.stderr)
            return 1
    if text is None and box_b is None:
        print("muse-lane: answer requires --text/--text-file and/or --box",
              file=sys.stderr)
        return 1
    if box_b is not None and state.get("box_state") == "held":
        print("muse-lane: cannot move box while the lane holds its box "
              "(box_state is held; wait for the accept to release it)",
              file=sys.stderr)
        return 2
    cwd = lane.get("cwd") or ""
    lane_dot = os.path.join(cwd, ".lane")
    nl = state.get("needs_lead") if isinstance(state.get("needs_lead"), dict) else None
    seq = nl.get("seq") if nl is not None else None
    secrets = secrets_from_env_file(lane.get("env_file"))
    lead_entry = None
    clear_question = False
    if text is not None:
        try:
            os.makedirs(lane_dot, exist_ok=True)
        except OSError as e:
            print("muse-lane: cannot create .lane dir: %s" % e, file=sys.stderr)
            return 1
        body = text if text.endswith("\n") else text + "\n"
        try:
            atomic_write_text(os.path.join(lane_dot, "ANSWER.md"), body)
            if seq is not None:
                atomic_write_text(os.path.join(lane_dot, "ANSWER-lead-%s.md" % seq), body)
        except OSError as e:
            print("muse-lane: cannot write answer: %s" % e, file=sys.stderr)
            return 1
        if nl is not None and nl.get("kind") == "question":
            clear_question = True
        try:
            step = int(state.get("step") or 1)
        except (TypeError, ValueError):
            step = 1
        qprev = ""
        if nl is not None:
            qprev = redact_text(str(nl.get("detail") or "")[:CONSULT_QUESTION_PREVIEW], secrets)
        lead_entry = {
            "step": step,
            "n": _consult_next_n(state, cwd),
            "question_preview": qprev,
            "answered": True,
            "helper": "lead",
            "by": "lead",
            "escalated": False,
            "answer_preview": redact_text(text[:CONSULT_ANSWER_PREVIEW], secrets),
        }
    # Liveness first: under a live supervisor answer never touches
    # lane.json or tickets itself. A check-then-move here races the
    # supervisor's hold decision (it can switch to held between our
    # state.json read and our ticket move, freeing the old box while
    # our waiter still counts as queued on it). The live path writes a
    # box sidecar only; the supervisor applies it inside its wait loop
    # in the same poll iteration that decides whether to hold.
    try:
        live = supervisor_alive(ldir)
    except Exception:
        live = False
    if box_b is not None and live:
        try:
            if lead_entry is not None:
                write_lead_sidecar(ldir, "consult", {"entry": lead_entry})
                if clear_question:
                    write_lead_sidecar(ldir, "clear", {"kind": "question", "seq": seq})
            write_lead_sidecar(ldir, "box", {"box": box_b})
        except OSError as e:
            print("muse-lane: cannot write lead sidecar: %s" % e, file=sys.stderr)
            return 1
        print("box move requested")
        return 0
    if box_b is not None:
        # Orphaned direct path (a live supervisor returned above):
        # lane.json first, then the ticket move, so a waiter that
        # wakes mid-move derives the new box before adopting the
        # ticket below it.
        lane["box"] = box_b
        try:
            atomic_write_json(os.path.join(ldir, "lane.json"), lane)
        except OSError as e:
            print("muse-lane: cannot write lane: %s" % e, file=sys.stderr)
            return 1
        try:
            move_own_box_tickets(lane_id, box_b)
        except OSError as e:
            print("muse-lane: cannot move box ticket: %s" % e, file=sys.stderr)
            return 1
    if live:
        # Never rewrite state.json under a live supervisor: it merges
        # these sidecars into its in-memory state on its next poll.
        # (A live box move returned above; this is the text-only path.)
        try:
            if lead_entry is not None:
                write_lead_sidecar(ldir, "consult", {"entry": lead_entry})
                if clear_question:
                    write_lead_sidecar(ldir, "clear", {"kind": "question", "seq": seq})
        except OSError as e:
            print("muse-lane: cannot write lead sidecar: %s" % e, file=sys.stderr)
            return 1
        return 0
    new_nl = nl
    consults = list(state.get("consults") or [])
    if lead_entry is not None:
        consults.append(lead_entry)
        if clear_question:
            new_nl = None
    if box_b is not None and isinstance(new_nl, dict) and new_nl.get("kind") == "box_wait_timeout":
        new_nl = None
    state["needs_lead"] = new_nl
    state["consults"] = consults
    state["updated_at"] = now_iso()
    try:
        atomic_write_json(os.path.join(ldir, "state.json"), state)
    except OSError as e:
        print("muse-lane: cannot write state: %s" % e, file=sys.stderr)
        return 1
    return 0


def cmd_boxes(args):
    cfg, cfg_err = load_effective_config()
    if cfg_err is not None:
        print("muse-lane: %s; leases unavailable" % cfg_err, file=sys.stderr)
        cfg = None
    tickets_by_box = {}
    broot = boxes_root()
    try:
        box_names = os.listdir(broot)
    except OSError:
        box_names = []
    for box in box_names:
        if not os.path.isdir(os.path.join(broot, box)):
            continue
        tickets = list_box_tickets(box)
        if tickets:
            tickets_by_box[box] = tickets
    lease_text = None
    lease_file = (cfg or {}).get("lease_file")
    if lease_file:
        try:
            with open(os.path.abspath(os.path.expanduser(lease_file)), "r",
                      encoding="utf-8", errors="replace") as f:
                lease_text = f.read()
        except OSError:
            lease_text = None
    held, lease_boxes = parse_box_leases(
        lease_text, (cfg or {}).get("lease_claim_re"),
        (cfg or {}).get("lease_release_re"))
    for box in lease_boxes:
        tickets_by_box.setdefault(box, [])
    out = []
    for box in sorted(tickets_by_box):
        holder, queue = box_holder_and_queue(box, tickets_by_box[box])
        out.append({"box": box, "holder_lane": holder, "queue": queue,
                    "lease": held.get(box)})
    if bool(getattr(args, "json", False)):
        print(json.dumps(out, indent=2))
        return 0
    if not out:
        print("(no boxes)")
        return 0
    for o in out:
        lease = o["lease"] if isinstance(o["lease"], dict) else None
        if lease is None:
            lease_s = "-"
        else:
            lease_s = "%s:%s since %s" % (lease.get("who") or "?",
                                          lease.get("what") or "?",
                                          lease.get("since") or "?")
        print("%s holder=%s queue=%s lease=%s" % (
            o["box"], o["holder_lane"] or "-",
            ",".join(o["queue"]) or "-", lease_s))
    return 0


# ---------------- supervisor ----------------

def _parse_poll_sec(env=None):
    src = env if env is not None else os.environ
    try:
        v = float(src.get("MUSE_LANE_POLL_SEC", str(DEFAULT_POLL_SEC)))
    except (TypeError, ValueError):
        return DEFAULT_POLL_SEC
    if v <= 0:
        return 0.1
    return v


def _parse_backoff(env=None):
    src = env if env is not None else os.environ
    raw = src.get("MUSE_LANE_BACKOFF", "")
    if not str(raw).strip():
        return list(DEFAULT_BACKOFF)
    out = []
    for part in str(raw).split(","):
        part = part.strip()
        if not part:
            continue
        try:
            out.append(float(part))
        except ValueError:
            continue
    return out or list(DEFAULT_BACKOFF)


def _kill_process_group(proc, sig):
    try:
        os.killpg(proc.pid, sig)
    except (ProcessLookupError, PermissionError, OSError):
        pass
    try:
        proc.send_signal(sig)
    except Exception:
        pass


def cmd_run(lane_id):
    ldir = lane_dir(lane_id)
    lane_path = os.path.join(ldir, "lane.json")
    lane = load_json(lane_path, None)
    if lane is None:
        print("muse-lane _run: unknown lane: %s" % lane_id, file=sys.stderr)
        return 1
    # One supervisor per lane: hold an exclusive flock for our whole life.
    lock_fd = None
    try:
        _ensure_lane_perms(ldir)
        lock_fd = os.open(lock_path_for_lane(ldir), os.O_RDWR | os.O_CREAT, 0o600)
        try:
            os.fchmod(lock_fd, 0o600)
        except OSError:
            pass
        # Retry briefly: status/resume probes take the lock for a moment.
        lock_deadline = time.monotonic() + LOCK_RETRY_SEC
        while True:
            try:
                fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                pass
            except OSError as e:
                if e.errno not in (errno.EACCES, errno.EAGAIN):
                    raise
            if time.monotonic() >= lock_deadline:
                print("muse-lane _run: another supervisor holds the lock", file=sys.stderr)
                try:
                    os.close(lock_fd)
                except OSError:
                    pass
                return 1
            time.sleep(0.05)
    except OSError as e:
        print("muse-lane _run: cannot take supervisor lock: %s" % e, file=sys.stderr)
        return 1
    # Fresh start or resume: drop our own stale tickets in every box
    # before anything else, so a dead incarnation never blocks a queue.
    try:
        for _sbox, _sfn in find_own_box_tickets(lane_id):
            remove_box_ticket(_sbox, _sfn)
    except Exception:
        pass
    # A stop that landed before we started: exit stopped without
    # overwriting the marker or a terminal state stop already wrote.
    if os.path.exists(os.path.join(ldir, STOP_MARKER)):
        st0 = load_json(os.path.join(ldir, "state.json"), None)
        if isinstance(st0, dict) and st0.get("status") in TERMINAL:
            return 0
        # Marker with non-terminal state (crash between marker and state):
        # write summary BEFORE stopped state, keep the marker.
        try:
            tmp_lane = lane or {}
            tmp_state = st0 or {}
            new_state, ended = _build_stopped_state(tmp_lane, tmp_state)
            try:
                write_summary_file(ldir, "stopped", ended, final_state=new_state)
            except Exception:
                pass
            atomic_write_json(os.path.join(ldir, "state.json"), new_state)
        except Exception:
            pass
        return 0
    cwd = lane.get("cwd") or os.getcwd()
    steps = len(lane.get("briefs") or [])
    if steps <= 0:
        print("muse-lane _run: lane has no briefs", file=sys.stderr)
        return 1
    effort = lane.get("effort") or "max"
    accept_cmd = lane.get("accept")
    env_file = lane.get("env_file")
    rcfg = lane.get("review") if isinstance(lane.get("review"), dict) else {}
    review_enabled = bool(rcfg.get("enabled"))
    try:
        _rr = rcfg.get("rounds")
        review_rounds_max = int(1 if _rr is None else _rr)
    except (TypeError, ValueError):
        review_rounds_max = 1
    if review_rounds_max < 0:
        review_rounds_max = 0
    # rounds counts fix re-runs, not reviews: 1 initial review plus one
    # review per fix, so 0 means review once with no fix.
    review_total = review_rounds_max + 1
    review_extra = rcfg.get("brief")
    try:
        lane_stall_sec = float(lane.get("stall_sec", 40 * 60))
    except (TypeError, ValueError):
        lane_stall_sec = 40 * 60

    # Resume environment: stored MUSE_BIN/PATH/MUSE_LANE_* win over ours.
    exec_env = lane.get("exec_env") if isinstance(lane.get("exec_env"), dict) else {}
    eff = dict(os.environ)
    for k, v in exec_env.items():
        if k in ("MUSE_BIN", "CLAUDE_BIN") or k == "PATH" or k.startswith("MUSE_LANE_"):
            eff[k] = v
    poll_sec = _parse_poll_sec(eff)
    backoff = _parse_backoff(eff)
    stall_env = eff.get("MUSE_LANE_STALL_SEC")
    if stall_env is not None and str(stall_env).strip() != "":
        try:
            stall_sec = float(stall_env)
        except ValueError:
            stall_sec = lane_stall_sec
    else:
        stall_sec = lane_stall_sec
    if stall_sec <= 0:
        stall_sec = 1.0
    review_timeout_sec = REVIEW_TIMEOUT_SEC
    try:
        rto = eff.get("MUSE_LANE_REVIEW_TIMEOUT_SEC")
        if rto is not None and str(rto).strip() != "":
            review_timeout_sec = float(rto)
    except (TypeError, ValueError):
        pass
    if review_timeout_sec <= 0:
        review_timeout_sec = 1.0
    try:
        _cm = lane.get("consult_max", CONSULT_MAX_DEFAULT)
        consult_max = int(CONSULT_MAX_DEFAULT if _cm is None else _cm)
    except (TypeError, ValueError):
        consult_max = CONSULT_MAX_DEFAULT
    try:
        consult_timeout_sec = float(lane.get("consult_timeout_sec", CONSULT_TIMEOUT_SEC))
    except (TypeError, ValueError):
        consult_timeout_sec = float(CONSULT_TIMEOUT_SEC)
    try:
        cmo = eff.get("MUSE_LANE_CONSULT_MAX")
        if cmo is not None and str(cmo).strip() != "":
            consult_max = int(cmo)
    except (TypeError, ValueError):
        pass
    try:
        cto = eff.get("MUSE_LANE_CONSULT_TIMEOUT_SEC")
        if cto is not None and str(cto).strip() != "":
            consult_timeout_sec = float(cto)
    except (TypeError, ValueError):
        pass
    if consult_max < 0:
        consult_max = 0
    if consult_timeout_sec <= 0:
        consult_timeout_sec = 1.0
    muse_bin = (eff.get("MUSE_BIN", "") or "muse") or "muse"
    lane_advisor = lane.get("advisor") if isinstance(lane.get("advisor"), dict) else None
    advisor_model = None
    advisor_max = 0
    if lane_advisor is not None:
        _am = lane_advisor.get("model") or ADVISOR_DEFAULT_MODEL
        advisor_model = _am if _am in ADVISOR_MODELS else ADVISOR_DEFAULT_MODEL
        try:
            advisor_max = int(lane_advisor.get("max", ADVISOR_DEFAULT_MAX))
        except (TypeError, ValueError):
            advisor_max = ADVISOR_DEFAULT_MAX
        if advisor_max < 0:
            advisor_max = 0
    advisor_enabled = bool(lane_advisor is not None and advisor_max > 0)
    lane_config_early = lane.get("config") if isinstance(lane.get("config"), dict) else {}
    try:
        advisor_timeout_sec = float(lane_config_early.get("advisor_timeout_min", 15)) * 60.0
    except (TypeError, ValueError):
        advisor_timeout_sec = 15 * 60.0
    try:
        _ato = eff.get("MUSE_LANE_ADVISOR_TIMEOUT_SEC")
        if _ato is not None and str(_ato).strip() != "":
            advisor_timeout_sec = float(_ato)
    except (TypeError, ValueError):
        pass
    if advisor_timeout_sec <= 0:
        advisor_timeout_sec = 1.0
    claude_bin = (eff.get("CLAUDE_BIN", "") or "").strip()
    try:
        box_wait_max_sec = float(lane_config_early.get("box_wait_max_min", 30)) * 60.0
    except (TypeError, ValueError):
        box_wait_max_sec = 30 * 60.0
    try:
        _bwo = eff.get("MUSE_LANE_BOX_WAIT_MAX_SEC")
        if _bwo is not None and str(_bwo).strip() != "":
            box_wait_max_sec = float(_bwo)
    except (TypeError, ValueError):
        pass
    if box_wait_max_sec <= 0:
        box_wait_max_sec = 1.0

    secrets = secrets_from_env_file(env_file)
    # In-memory snapshot (never on disk): redaction always uses the union
    # of this and the current env file, so rotated-out values stay redacted.
    secret_snapshot = list(secrets)
    try:
        self_started = get_start_time(os.getpid())
    except Exception:
        self_started = None
    env_file_vars = parse_env_file(env_file) if env_file else {}
    muse_env = dict(os.environ)
    if eff.get("PATH"):
        muse_env["PATH"] = eff["PATH"]
    if env_file_vars:
        muse_env.update(env_file_vars)
    if lane.get("accept_env"):
        accept_env = dict(muse_env)
    else:
        accept_env = dict(os.environ)
        if eff.get("PATH"):
            accept_env["PATH"] = eff["PATH"]
        # Do not leak env-file keys into acceptance without --accept-env.

    state_path = os.path.join(ldir, "state.json")
    history_path = os.path.join(ldir, "history.json")
    history = load_json(history_path, {}) or {}
    if not isinstance(history, dict):
        history = {}

    def slog(msg):
        try:
            print("[%s] %s" % (now_iso(), redact_text(str(msg), secrets)), flush=True)
        except Exception:
            pass

    # ---- resume / fresh-start resolution ----
    prev_state = load_json(state_path, None)
    started_at = None
    head_start = None
    start_step = 1
    start_attempt = 1
    last_reason = None
    accept_exit = None
    if prev_state is not None and isinstance(prev_state, dict):
        if prev_state.get("status") in TERMINAL:
            slog("lane already %s; _run exiting" % prev_state.get("status"))
            return 0
        if prev_state.get("status") in NON_TERMINAL:
            started_at = prev_state.get("started_at")
            head_start = prev_state.get("head_start")
            last_reason = prev_state.get("reason")
            accept_exit = prev_state.get("accept_exit")
            try:
                prev_step = int(prev_state.get("step") or 1)
            except (TypeError, ValueError):
                prev_step = 1
            try:
                prev_attempt = int(prev_state.get("attempt") or 1)
            except (TypeError, ValueError):
                prev_attempt = 1
            prev_status = prev_state.get("status")
            if prev_status == "queued":
                start_step = max(1, min(prev_step, steps))
                start_attempt = 1
            elif prev_status == "accepting":
                start_step = steps + 1
                start_attempt = 1
            else:
                final_p = os.path.join(ldir, "step%d-final.md" % prev_step)
                if os.path.exists(final_p):
                    start_step = prev_step + 1
                    start_attempt = 1
                else:
                    start_step = max(1, min(prev_step, steps))
                    probe = os.path.join(ldir, "step%d-attempt%d.jsonl" % (start_step, prev_attempt))
                    if os.path.exists(probe):
                        start_attempt = prev_attempt + 1
                    else:
                        start_attempt = prev_attempt
                    if start_attempt < 1:
                        start_attempt = 1
            slog("resuming from step %d attempt %d (prev %s step %d att %d)" % (
                start_step, start_attempt, prev_status, prev_step, prev_attempt))
    if not started_at:
        started_at = now_iso()
    if head_start is None and not (prev_state and "head_start" in (prev_state or {})):
        try:
            head_start = get_git_head(cwd) if os.path.isdir(cwd) else None
        except Exception:
            head_start = None
    elif head_start is None and prev_state is not None:
        head_start = prev_state.get("head_start")
    # Phase/review holders (old states lack these keys; .get defaults keep them readable).
    phase_holder = {"phase": (prev_state or {}).get("phase"),
                    "phase_started": (prev_state or {}).get("phase_started")}
    review_rounds_done = list((prev_state or {}).get("review_rounds") or [])
    review_error_holder = {"v": (prev_state or {}).get("review_error")}
    consults_done = list((prev_state or {}).get("consults") or [])
    try:
        _nl_seq = int((prev_state or {}).get("needs_lead_seq") or 0)
    except (TypeError, ValueError):
        _nl_seq = 0
    _nl_cur = (prev_state or {}).get("needs_lead")
    if isinstance(_nl_cur, dict):
        try:
            _nl_cur_seq = int(_nl_cur.get("seq") or 0)
        except (TypeError, ValueError):
            _nl_cur_seq = 0
        if _nl_cur_seq > _nl_seq:
            _nl_seq = _nl_cur_seq
    else:
        _nl_cur = None
    needs_lead_holder = {"current": _nl_cur, "seq": _nl_seq}
    box_state_holder = {"v": (prev_state or {}).get("box_state")}
    box_queued_at_holder = {"v": (prev_state or {}).get("box_queued_at")}
    in_box_wait_holder = {"v": False}
    _br0 = (prev_state or {}).get("box_move_refusals")
    box_refusals_holder = {"v": list(_br0) if isinstance(_br0, list) else []}
    pending_box_moves = []
    try:
        _ac = int((prev_state or {}).get("advisor_calls") or 0)
    except (TypeError, ValueError):
        _ac = 0
    advisor_calls_holder = {"v": _ac}
    evidence_holder = {"v": (prev_state or {}).get("evidence")}
    lane_scope = list(lane.get("scope") or []) if isinstance(lane.get("scope"), list) else []
    lane_config = lane.get("config") if isinstance(lane.get("config"), dict) else {}
    current_last_event = (prev_state or {}).get("last_event")

    def raise_needs_lead(kind, detail, step=None):
        """Record a needs-lead event; each raise bumps seq. Returns the event."""
        try:
            seq = int(needs_lead_holder.get("seq") or 0) + 1
        except (TypeError, ValueError):
            seq = 1
        needs_lead_holder["seq"] = seq
        det = redact_text((detail or "")[:NEEDS_LEAD_DETAIL_CAP], secrets)
        ev = {"seq": seq, "kind": kind, "detail": det, "at": now_iso()}
        if step is not None:
            try:
                ev["step"] = int(step)
            except (TypeError, ValueError):
                pass
        needs_lead_holder["current"] = ev
        slog("needs-lead %s seq=%d step=%s: %s" % (
            kind, seq, ev.get("step"), det[:160]))
        return ev

    def merge_lead_sidecars():
        """Apply lead-*.json sidecars to in-memory state; rename to .merged.

        clear drops a matching open needs-lead event, consult appends the
        lead's consult entry (n reassigned past in-memory entries), box
        queues a move for the box waiter when the lane is inside its wait
        loop and queued, and is rejected otherwise (invalid, held, or not
        waiting): the merged file gains a `rejected` reason and the refusal
        is noted for the summary. Unparseable files are still marked merged
        so one bad file cannot wedge every poll.
        """
        try:
            names = sorted(os.listdir(ldir))
        except OSError:
            return
        for fn in names:
            if not fn.startswith(LEAD_SIDECAR_PREFIX):
                continue
            if not fn.endswith(LEAD_SIDECAR_SUFFIX):
                continue
            path = os.path.join(ldir, fn)
            try:
                with open(path, "r", encoding="utf-8", errors="replace") as f:
                    sc = json.load(f)
            except (OSError, ValueError):
                sc = None
            rejected_reason = None
            try:
                if isinstance(sc, dict):
                    kind = sc.get("kind")
                    payload = sc.get("payload")
                    if not isinstance(payload, dict):
                        payload = {}
                    if kind == "clear":
                        if should_apply_lead_clear(needs_lead_holder["current"],
                                                   payload.get("kind"), payload.get("seq")):
                            needs_lead_holder["current"] = None
                            slog("merged lead clear %s seq=%s" % (
                                payload.get("kind"), payload.get("seq")))
                    elif kind == "consult":
                        entry = payload.get("entry")
                        if isinstance(entry, dict):
                            entry = dict(entry)
                            # Module helper, not the consult_next_n
                            # closure: merge also runs on resume paths
                            # reached before that closure is defined.
                            entry["n"] = _max_consult_n(consults_done) + 1
                            consults_done.append(entry)
                            slog("merged lead consult n=%s" % entry.get("n"))
                    elif kind == "box":
                        _target = payload.get("box")
                        _berr = (box_name_error(_target)
                                 if isinstance(_target, str) else "must be non-empty")
                        if _berr is not None:
                            rejected_reason = "invalid box %r: %s" % (_target, _berr)
                            slog("rejected lead box move to %r: %s" % (_target, _berr))
                            box_refusals_holder["v"].append(
                                "box move to %s refused: %s" % (_target, rejected_reason))
                        elif (in_box_wait_holder.get("v") and
                                box_state_holder.get("v") == "queued"):
                            pending_box_moves.append({
                                "box": _target,
                                "ticket": payload.get("ticket"),
                            })
                            slog("merged lead box move to %s" % _target)
                        else:
                            if box_state_holder.get("v") == "held":
                                _held_box = None
                                try:
                                    _fresh = load_json(os.path.join(ldir, "lane.json"), None)
                                    if isinstance(_fresh, dict):
                                        _held_box = _fresh.get("box")
                                except Exception:
                                    _held_box = None
                                if not _held_box:
                                    try:
                                        _held_box = lane.get("box")
                                    except Exception:
                                        _held_box = None
                                rejected_reason = "lane held %s" % (_held_box or "?")
                            else:
                                rejected_reason = "lane not waiting"
                            slog("rejected lead box move to %s: %s" % (
                                _target, rejected_reason))
                            box_refusals_holder["v"].append(
                                "box move to %s refused: %s" % (_target, rejected_reason))
            finally:
                try:
                    os.rename(path, path + LEAD_SIDECAR_MERGED_SUFFIX)
                except OSError:
                    pass
                else:
                    if rejected_reason is not None and isinstance(sc, dict):
                        try:
                            _m = dict(sc)
                            _m["rejected"] = rejected_reason
                            _m["rejected_at"] = now_iso()
                            atomic_write_json(path + LEAD_SIDECAR_MERGED_SUFFIX, _m)
                        except OSError:
                            pass
    # Resume past a passed accept goes straight to review: all step finals are
    # present (start_step > steps) and the accept already passed (accept_exit 0).
    skip_accept = bool(review_enabled and start_step > steps and accept_exit == 0)

    def set_phase(v):
        if v != phase_holder["phase"]:
            phase_holder["phase"] = v
            phase_holder["phase_started"] = now_iso()

    stop_requested = {"flag": False}

    def _on_term(signum, frame):
        stop_requested["flag"] = True

    try:
        signal.signal(signal.SIGTERM, _on_term)
        signal.signal(signal.SIGINT, _on_term)
    except Exception:
        pass

    def git_snapshot():
        try:
            head = get_git_head(cwd) if os.path.isdir(cwd) else None
        except Exception:
            head = None
        try:
            commits = get_commits_count(cwd, head_start, head) if os.path.isdir(cwd) else 0
        except Exception:
            commits = 0
        return head, commits

    def write_state(status, step, attempt, muse_pid, last_activity_at,
                    last_event, head, commits, stderr_tail, accept_exit_v,
                    retry_at, reason, muse_started=None, accept_pid=None,
                    accept_started=None):
        merge_lead_sidecars()
        st = {
            "status": status,
            "step": int(step),
            "steps": int(steps),
            "attempt": int(attempt),
            "supervisor_pid": os.getpid(),
            "supervisor_started": self_started,
            "muse_pid": muse_pid,
            "muse_started": muse_started,
            "accept_pid": accept_pid,
            "accept_started": accept_started,
            "started_at": started_at,
            "updated_at": now_iso(),
            "last_activity_at": last_activity_at or now_iso(),
            "last_event": last_event,
            "head_start": head_start,
            "head": head,
            "commits": int(commits or 0),
            "stderr_tail": stderr_tail or "",
            "accept_exit": accept_exit_v,
            "retry_at": retry_at,
            "reason": reason,
            "phase": phase_holder["phase"],
            "phase_started": phase_holder["phase_started"],
            "review_rounds": review_rounds_done,
            "review_error": review_error_holder["v"],
            "consults": consults_done,
            "needs_lead": needs_lead_holder["current"],
            "needs_lead_seq": needs_lead_holder["seq"],
            "box_state": box_state_holder["v"],
            "box_queued_at": box_queued_at_holder["v"],
            "box_move_refusals": list(box_refusals_holder["v"]),
            "evidence": evidence_holder["v"],
            "advisor_calls": advisor_calls_holder["v"],
        }
        for k, v in list(st.items()):
            if isinstance(v, str):
                st[k] = redact_text(v, secrets)
        atomic_write_json(state_path, st)
        return st

    def save_history():
        try:
            atomic_write_json(history_path, history)
        except OSError:
            pass

    def _stop_marker_present():
        return os.path.exists(os.path.join(ldir, STOP_MARKER))

    def _redact_sweep():
        redact_sweep_ldir(ldir, secrets)

    def finish_terminal(status, step, attempt, reason, accept_exit_v, last_event=None, stderr_tail=""):
        nonlocal secrets
        # A pending stop (TERM flag or marker) turns any terminal outcome
        # into stopped: our own stop is never reclassified as a failure.
        if status != "stopped" and (stop_requested["flag"] or _stop_marker_present()):
            status = "stopped"
            reason = "stopped"
        merge_lead_sidecars()
        secrets = union_secrets(secret_snapshot, secrets_from_env_file(env_file))
        head, commits = git_snapshot()
        ended = now_iso()
        prev = load_json(state_path, {}) or {}
        if status == "done":
            try:
                _br = get_git_branch(cwd) if cwd and os.path.isdir(cwd) else None
            except Exception:
                _br = None
            try:
                ev = build_evidence(ldir, lane, {"head_start": head_start},
                                    head, commits, branch=_br)
            except Exception:
                ev = None
            evidence_holder["v"] = ev
        else:
            evidence_holder["v"] = None
        final = {
            "status": status,
            "step": int(step),
            "steps": int(steps),
            "attempt": int(attempt),
            "supervisor_pid": os.getpid(),
            "supervisor_started": self_started,
            "muse_pid": None,
            "muse_started": None,
            "accept_pid": None,
            "accept_started": None,
            "started_at": started_at,
            "updated_at": ended,
            "last_activity_at": prev.get("last_activity_at") or ended,
            "last_event": last_event if last_event is not None else prev.get("last_event"),
            "head_start": head_start,
            "head": head,
            "commits": int(commits or 0),
            "stderr_tail": stderr_tail if stderr_tail is not None else (prev.get("stderr_tail") or ""),
            "accept_exit": accept_exit_v,
            "retry_at": None,
            "reason": redact_text(reason, secrets) if reason else reason,
            "phase": phase_holder["phase"],
            "phase_started": phase_holder["phase_started"],
            "review_rounds": review_rounds_done,
            "review_error": review_error_holder["v"],
            "consults": consults_done,
            "needs_lead": needs_lead_holder["current"],
            "needs_lead_seq": needs_lead_holder["seq"],
            "box_state": box_state_holder["v"],
            "box_queued_at": box_queued_at_holder["v"],
            "box_move_refusals": list(box_refusals_holder["v"]),
            "evidence": evidence_holder["v"],
            "advisor_calls": advisor_calls_holder["v"],
        }
        # Summary BEFORE terminal state on every exit path.
        try:
            write_summary_file(ldir, status, ended, final_state=final,
                               extra_secrets=secret_snapshot)
        except Exception as e:
            slog("failed to write summary: %s" % e)
        atomic_write_json(state_path, final)
        _redact_sweep()
        slog("lane %s -> %s" % (lane_id, status))
        return 0

    def sleep_with_state_updates(delay, status, step, attempt, retry_at, reason, err_path_for_tail):
        end = time.monotonic() + max(0.0, delay)
        last_update = 0.0
        while True:
            if stop_requested["flag"] or _stop_marker_present():
                return "stopped"
            now_m = time.monotonic()
            if now_m >= end:
                return "ok"
            if now_m - last_update >= poll_sec:
                head, commits = git_snapshot()
                tail = "\n".join(read_tail_filtered(err_path_for_tail))
                tail = redact_text(tail, secrets)
                write_state(status, step, attempt, None, now_iso(), None,
                            head, commits, tail, accept_exit, retry_at,
                            redact_text(reason, secrets) if reason else reason)
                last_update = now_m
            remain = end - now_m
            time.sleep(min(0.2, max(0.05, min(poll_sec, remain))))

    # If resume landed past the last step, jump straight to acceptance.
    if start_step > steps:
        pass
    else:
        if start_attempt > MAX_ATTEMPTS:
            slog("step %d already exhausted %d attempts before resume; giving up" % (start_step, MAX_ATTEMPTS))
            return finish_terminal("gave_up", start_step, MAX_ATTEMPTS, last_reason or "out of attempts", accept_exit)

    # ---- mid-step consults (ASK.md / ANSWER.md) ----
    def consult_step_count(k):
        return sum(1 for e in consults_done if e.get("step") == k)

    def consult_next_n():
        m = _max_consult_n(consults_done)
        try:
            for fn in os.listdir(os.path.join(cwd, ".lane")):
                if fn.startswith("ASK-") and fn.endswith(".md"):
                    try:
                        m = max(m, int(fn[4:-3]))
                    except ValueError:
                        pass
        except OSError:
            pass
        return m + 1

    def run_consult_helper(k, n, question):
        """Fresh read-only helper for ASK-n. Returns (status, final_text) with
        status in {"ok", "timeout", "failed"}."""
        brief = ("You are answering one mid-step question from a Muse agent working in this directory.\n"
                 "Read-only: this session cannot write files. Do not modify, create, or delete anything. Do not run long commands.\n"
                 "If this needs a lead decision (different acceptance, scope, or a product choice), answer with the first line ESCALATE: <one line>.\n"
                 "\n"
                 "Question from step %d (saved as .lane/ASK-%d.md):\n"
                 "\n%s\n"
                 "\n---\n"
                 "Your final answer IS the answer: the supervisor saves it to .lane/ANSWER-%d.md and .lane/ANSWER.md itself.\n"
                 "Keep the answer short and concrete; cite file:line paths you read.\n") % (
                     k, n, (question or "(empty)").strip(), n)
        bpath = os.path.join(ldir, "consult-brief-%d.md" % n)
        try:
            atomic_write_text(bpath, redact_text(brief, secrets))
        except OSError:
            return ("failed", "")
        jsonl_path = os.path.join(ldir, "consult-%d.jsonl" % n)
        err_path = os.path.join(ldir, "consult-%d.err" % n)
        cmd = [muse_bin, "exec", "--prompt-file", bpath,
               "--trust-workspace", "--approval-mode", "never",
               "--disable-approval", "--disable-write",
               "--reasoning-effort", "high", "--json",
               # Owner 2026-10-16: no network from inside Muse's shell sandbox (two lanes built ssh stand-ins
               # to reach the lab runner with ~/.ssh keys). Remote steps run in the unsandboxed accept.
               "--sandbox-network", os.environ.get("MUSE_LANE_SANDBOX_NETWORK", "restricted")]
        slog("consult step %d #%d: %s" % (k, n, " ".join(cmd)))
        try:
            jf = open(jsonl_path, "w", encoding="utf-8", errors="replace")
            try:
                os.fchmod(jf.fileno(), 0o600)
            except OSError:
                pass
            ef = open(err_path, "w", encoding="utf-8", errors="replace")
            try:
                os.fchmod(ef.fileno(), 0o600)
            except OSError:
                pass
        except OSError:
            try:
                jf.close()
            except Exception:
                pass
            try:
                ef.close()
            except Exception:
                pass
            return ("failed", "")
        try:
            proc = subprocess.Popen(cmd, cwd=cwd, env=muse_env,
                                    stdin=subprocess.DEVNULL, stdout=jf, stderr=ef,
                                    start_new_session=True)
        except Exception as e:
            try:
                jf.close()
            except Exception:
                pass
            try:
                ef.close()
            except Exception:
                pass
            slog("consult helper spawn failed: %s" % e)
            return ("failed", "")
        start_m = time.monotonic()
        rc = None
        timed_out = False
        while True:
            if stop_requested["flag"] or _stop_marker_present():
                _kill_process_group(proc, signal.SIGTERM)
                try:
                    proc.wait(timeout=5)
                except Exception:
                    _kill_process_group(proc, signal.SIGKILL)
                    try:
                        proc.wait(timeout=5)
                    except Exception:
                        pass
                try:
                    jf.close()
                except Exception:
                    pass
                try:
                    ef.close()
                except Exception:
                    pass
                redact_file_inplace(jsonl_path, secrets)
                redact_file_inplace(err_path, secrets)
                return ("failed", "")
            ret = proc.poll()
            now_m = time.monotonic()
            if ret is None and now_m - start_m >= consult_timeout_sec:
                timed_out = True
                slog("consult step %d #%d timed out after %.0fs" % (k, n, now_m - start_m))
                _kill_process_group(proc, signal.SIGTERM)
                try:
                    proc.wait(timeout=10)
                except Exception:
                    _kill_process_group(proc, signal.SIGKILL)
                    try:
                        proc.wait(timeout=5)
                    except Exception:
                        pass
                ret = proc.returncode
            if ret is not None:
                rc = ret
                break
            time.sleep(min(0.2, poll_sec))
        try:
            jf.close()
        except Exception:
            pass
        try:
            ef.close()
        except Exception:
            pass
        _chmod_0600(jsonl_path)
        _chmod_0600(err_path)
        redact_file_inplace(jsonl_path, secrets)
        redact_file_inplace(err_path, secrets)
        if timed_out:
            return ("timeout", "")
        ok, text = check_completion(jsonl_path)
        if ok:
            return ("ok", text or "")
        return ("failed", text or "")

    def run_advisor(k, n, question):
        """One advisor call for ASK-n. Returns (status, text, advisor_error).

        status in {"ok", "timeout", "failed"}; advisor_error is None for
        "ok", else an exit-code-and-line string for the consult log. No
        git before/after guard: Muse keeps working while a consult runs,
        so its own edits would trip it. The read-only rail is the tool
        list (--tools Read,Grep,Glob), enforced at start.
        """
        advisor_calls_holder["v"] = int(advisor_calls_holder.get("v") or 0) + 1
        ask_name = "ASK-%d.md" % n
        prompt = build_advisor_prompt(question, ask_name, accept_cmd, lane_scope, k, n)
        prompt_path = os.path.join(ldir, "advisor-prompt-%d.md" % n)
        try:
            atomic_write_text(prompt_path, redact_text(prompt, secrets))
        except OSError:
            return ("failed", "", format_advisor_error(
                None, "cannot write advisor prompt", "", secrets))
        out_path = os.path.join(ldir, "advisor-%d.out" % n)
        err_path = os.path.join(ldir, "advisor-%d.err" % n)
        cfg_cmd = lane_config.get("advisor_cmd") if isinstance(lane_config, dict) else None
        cmd = build_advisor_cmd(cfg_cmd, advisor_model, claude_bin)
        slog("consult step %d #%d advisor (%s): %s" % (k, n, advisor_model, " ".join(cmd)))
        try:
            inf = open(prompt_path, "r", encoding="utf-8", errors="replace")
            outf = open(out_path, "w", encoding="utf-8", errors="replace")
            try:
                os.fchmod(outf.fileno(), 0o600)
            except OSError:
                pass
            ef = open(err_path, "w", encoding="utf-8", errors="replace")
            try:
                os.fchmod(ef.fileno(), 0o600)
            except OSError:
                pass
        except OSError:
            for _f in ("inf", "outf", "ef"):
                try:
                    locals()[_f].close()
                except Exception:
                    pass
            return ("failed", "", format_advisor_error(
                None, "cannot open advisor output files", "", secrets))
        try:
            proc = subprocess.Popen(cmd, cwd=cwd, env=muse_env,
                                    stdin=inf, stdout=outf, stderr=ef,
                                    start_new_session=True)
        except Exception as e:
            try:
                inf.close()
            except Exception:
                pass
            try:
                outf.close()
            except Exception:
                pass
            try:
                ef.close()
            except Exception:
                pass
            slog("advisor spawn failed: %s" % e)
            return ("failed", "", format_advisor_error(
                None, "advisor spawn failed: %s" % e, "", secrets))
        start_m = time.monotonic()
        timed_out = False
        rc = None
        while True:
            if stop_requested["flag"] or _stop_marker_present():
                _kill_process_group(proc, signal.SIGTERM)
                try:
                    proc.wait(timeout=5)
                except Exception:
                    _kill_process_group(proc, signal.SIGKILL)
                    try:
                        proc.wait(timeout=5)
                    except Exception:
                        pass
                try:
                    inf.close()
                except Exception:
                    pass
                try:
                    outf.close()
                except Exception:
                    pass
                try:
                    ef.close()
                except Exception:
                    pass
                redact_file_inplace(out_path, secrets)
                redact_file_inplace(err_path, secrets)
                return ("failed", "", None)
            ret = proc.poll()
            now_m = time.monotonic()
            if ret is None and now_m - start_m >= advisor_timeout_sec:
                timed_out = True
                slog("consult step %d #%d advisor timed out after %.0fs" % (k, n, now_m - start_m))
                _kill_process_group(proc, signal.SIGTERM)
                try:
                    proc.wait(timeout=10)
                except Exception:
                    _kill_process_group(proc, signal.SIGKILL)
                    try:
                        proc.wait(timeout=5)
                    except Exception:
                        pass
                ret = proc.returncode
            if ret is not None:
                rc = ret
                break
            time.sleep(min(0.2, poll_sec))
        try:
            inf.close()
        except Exception:
            pass
        try:
            outf.close()
        except Exception:
            pass
        try:
            ef.close()
        except Exception:
            pass
        _chmod_0600(out_path)
        _chmod_0600(err_path)
        redact_file_inplace(out_path, secrets)
        redact_file_inplace(err_path, secrets)

        def _adv_err(rc):
            try:
                with open(err_path, "r", encoding="utf-8", errors="replace") as f:
                    err_txt = f.read()
            except OSError:
                err_txt = ""
            try:
                with open(out_path, "r", encoding="utf-8", errors="replace") as f:
                    out_txt = f.read()
            except OSError:
                out_txt = ""
            return format_advisor_error(rc, err_txt, out_txt, secrets)

        if timed_out:
            return ("timeout", "", _adv_err(rc))
        if rc is not None and rc != 0:
            return ("failed", "", _adv_err(rc))
        try:
            with open(out_path, "r", encoding="utf-8", errors="replace") as f:
                text = f.read()
        except OSError:
            text = ""
        return ("ok", (text or "")[:ADVISOR_ANSWER_CAP], None)

    def maybe_handle_consult(k):
        """Answer one pending ASK.md for step k.

        True when one was handled, False when none was pending.
        """
        lane_dot = os.path.join(cwd, ".lane")
        ask_path = os.path.join(lane_dot, "ASK.md")
        try:
            if not os.path.isfile(ask_path):
                return False
        except OSError:
            return False
        try:
            with open(ask_path, "r", encoding="utf-8", errors="replace") as f:
                question = f.read()
        except OSError:
            return False
        n = consult_next_n()
        try:
            os.rename(ask_path, os.path.join(lane_dot, "ASK-%d.md" % n))
        except OSError:
            return False
        if consult_step_count(k) >= consult_max:
            msg = ("Consult limit reached (%d per step); no helper was run. "
                   "Keep working without an answer." % consult_max)
            try:
                atomic_write_text(os.path.join(lane_dot, "ANSWER-%d.md" % n), msg + "\n")
                atomic_write_text(os.path.join(lane_dot, "ANSWER.md"), msg + "\n")
            except OSError:
                pass
            consults_done.append({"step": k, "n": n,
                                  "question_preview": redact_text(
                                      question[:CONSULT_QUESTION_PREVIEW], secrets),
                                  "answered": False, "helper": "limited",
                                  "by": "muse", "escalated": False,
                                  "answer_preview": ""})
            slog("consult step %d #%d limited (max %d)" % (k, n, consult_max))
            return True
        use_advisor = bool(advisor_enabled and
                           int(advisor_calls_holder.get("v") or 0) < advisor_max)
        advisor_error = None
        if use_advisor:
            by = "claude-%s" % (advisor_model or ADVISOR_DEFAULT_MODEL)
            status, payload, advisor_error = run_advisor(k, n, question)
            if status in ("failed", "timeout") and not (
                    stop_requested["flag"] or _stop_marker_present()):
                # Advisor failure: the Muse helper answers the same
                # question in this same consult. The failed call already counts.
                slog("consult step %d #%d advisor %s (%s); falling back to muse" % (
                    k, n, status, advisor_error or "no detail"))
                use_advisor = False
                by = "muse"
                status, final_text = run_consult_helper(k, n, question)
            else:
                final_text = payload if status == "ok" else ""
                advisor_error = None
        else:
            by = "muse"
            status, final_text = run_consult_helper(k, n, question)
        ans_n = os.path.join(lane_dot, "ANSWER-%d.md" % n)
        # Neither backend can write; its final answer text is the answer and
        # the supervisor writes both files itself.
        answer = (final_text or "") if status == "ok" else ""
        answered = bool(answer.strip())
        fail_reason = ""
        escalated = False
        if status == "ok" and not answered:
            # Completed but produced no answer text: the answer below falls
            # back to the failure text, so never report this as ok.
            status = "failed"
            fail_reason = "completed with no answer text"
        elif status == "failed":
            fail_reason = "helper did not complete"
        esc_reason = parse_escalate_reason(answer) if answered else None
        if answered and esc_reason is not None:
            escalated = True
            reason_txt = (esc_reason or "").strip()
            raise_needs_lead("question", reason_txt, step=k)
            if reason_txt:
                answer = ("The lead was asked about this question (ESCALATE: %s). "
                          "Keep working on other parts or wait for a later ANSWER.md." % reason_txt)
            else:
                answer = ("The lead was asked about this question. "
                          "Keep working on other parts or wait for a later ANSWER.md.")
            try:
                atomic_write_text(ans_n, answer + "\n")
            except OSError:
                pass
            try:
                atomic_write_text(os.path.join(lane_dot, "ANSWER.md"), answer + "\n")
            except OSError:
                pass
            _ce = {"step": k, "n": n,
                     "question_preview": redact_text(
                         question[:CONSULT_QUESTION_PREVIEW], secrets),
                     "answered": True, "helper": status,
                     "by": by, "escalated": True,
                     "answer_preview": redact_text(
                         (final_text or "")[:CONSULT_ANSWER_PREVIEW], secrets)}
            if advisor_error:
                _ce["advisor_error"] = advisor_error
            consults_done.append(_ce)
            slog("consult step %d #%d %s by=%s escalated" % (k, n, status, by))
            return True
        if answered:
            try:
                atomic_write_text(ans_n, answer if answer.endswith("\n") else answer + "\n")
            except OSError:
                pass
        if not answered:
            who = "advisor" if use_advisor else "consult helper"
            if status == "timeout":
                answer = ("The %s timed out; no answer is coming. "
                          "Keep working without it." % who)
            else:
                answer = ("The %s failed; no answer is coming. "
                          "Keep working without it." % who)
            try:
                atomic_write_text(ans_n, answer + "\n")
            except OSError:
                pass
        try:
            atomic_write_text(os.path.join(lane_dot, "ANSWER.md"),
                              answer if answer.endswith("\n") else answer + "\n")
        except OSError:
            pass
        _ce = {"step": k, "n": n,
                 "question_preview": redact_text(
                     question[:CONSULT_QUESTION_PREVIEW], secrets),
                 "answered": answered, "helper": status,
                 "by": by, "escalated": False,
                 "answer_preview": redact_text(
                     answer[:CONSULT_ANSWER_PREVIEW], secrets)}
        if advisor_error:
            _ce["advisor_error"] = advisor_error
        consults_done.append(_ce)
        if fail_reason:
            slog("consult step %d #%d %s by=%s: %s" % (k, n, status, by, fail_reason))
        else:
            slog("consult step %d #%d %s by=%s" % (k, n, status, by))
        return True

    # ---- step execution (also used for post-review re-runs of the last step) ----
    # Returns ("ok",) when the step completes, else the finish_terminal code.
    def run_step(k, brief_path, n_start):
        nonlocal secrets, last_reason, current_last_event
        set_phase("step:%d" % k)
        if stop_requested["flag"] or _stop_marker_present():
            return finish_terminal("stopped", k, n_start,
                                   "stopped", accept_exit, current_last_event, "")
        step_done = False
        for n in range(n_start, MAX_ATTEMPTS + 1):
            if stop_requested["flag"] or _stop_marker_present():
                return finish_terminal("stopped", k, n, "stopped", accept_exit,
                                       current_last_event, "")
            secrets = union_secrets(secret_snapshot, secrets_from_env_file(env_file))
            if consult_max > 0:
                # Stale unnumbered Q&A from a dead attempt must not confuse this one.
                for _f in ("ASK.md", "ANSWER.md"):
                    try:
                        _p = os.path.join(cwd, ".lane", _f)
                        if os.path.isfile(_p):
                            os.remove(_p)
                    except OSError:
                        pass
            jsonl_path = os.path.join(ldir, "step%d-attempt%d.jsonl" % (k, n))
            err_path = os.path.join(ldir, "step%d-attempt%d.err" % (k, n))
            cmd = [muse_bin, "exec", "--prompt-file", brief_path,
                   "--trust-workspace", "--approval-mode", "never",
                   "--disable-approval", "--reasoning-effort", effort, "--json",
                   # Owner 2026-10-16: no network from inside Muse's shell sandbox (two lanes built ssh stand-ins
                   # to reach the lab runner with ~/.ssh keys). Remote steps run in the unsandboxed accept.
                   "--sandbox-network", os.environ.get("MUSE_LANE_SANDBOX_NETWORK", "restricted")]
            slog("step %d attempt %d: %s" % (k, n, " ".join(cmd)))
            head0, commits0 = git_snapshot()
            last_activity_iso = now_iso()
            write_state("running", k, n, None, last_activity_iso, current_last_event,
                        head0, commits0, "", accept_exit, None, last_reason)
            try:
                jf = open(jsonl_path, "w", encoding="utf-8", errors="replace")
                try:
                    os.fchmod(jf.fileno(), 0o600)
                except OSError:
                    pass
                ef = open(err_path, "w", encoding="utf-8", errors="replace")
                try:
                    os.fchmod(ef.fileno(), 0o600)
                except OSError:
                    pass
            except OSError as e:
                try:
                    jf.close()
                except Exception:
                    pass
                try:
                    ef.close()
                except Exception:
                    pass
                reason = redact_text("cannot open output files: %s" % e, secrets)
                last_reason = reason
                history.setdefault(str(k), []).append({
                    "attempt": n, "reason": reason, "ok": False,
                    "class": "fatal", "terminal": None, "exit": None})
                save_history()
                return finish_terminal("gave_up", k, n, reason, accept_exit,
                                       current_last_event, "")
            try:
                proc = subprocess.Popen(cmd, cwd=cwd, env=muse_env,
                                        stdin=subprocess.DEVNULL, stdout=jf, stderr=ef,
                                        start_new_session=True)
            except Exception as e:
                try:
                    jf.close()
                except Exception:
                    pass
                try:
                    ef.close()
                except Exception:
                    pass
                raw_reason = "spawn failed: %s" % e
                cls, reason = classify_failure(None, raw_reason, "", None,
                                               spawn_failed=True)
                reason = redact_text(reason, secrets)
                last_reason = reason
                history.setdefault(str(k), []).append({
                    "attempt": n, "reason": reason, "ok": False,
                    "class": cls, "terminal": None, "exit": None})
                save_history()
                redact_file_inplace(jsonl_path, secrets)
                redact_file_inplace(err_path, secrets)
                return finish_terminal("gave_up", k, n, reason, accept_exit,
                                       current_last_event, "")
            # Poll loop for this attempt.
            try:
                muse_started = get_start_time(proc.pid)
            except Exception:
                muse_started = None
            last_activity_m = time.monotonic()
            last_activity_iso = now_iso()
            try:
                last_jsonl_size = os.path.getsize(jsonl_path)
            except OSError:
                last_jsonl_size = 0
            try:
                last_err_size = os.path.getsize(err_path)
            except OSError:
                last_err_size = 0
            try:
                snap = get_activity_snapshot(cwd, proc.pid)
            except Exception:
                snap = {"head": None, "status": None, "dirty": {}, "cpu": None}
            last_head = snap.get("head")
            last_status_out = snap.get("status")
            last_dirty = snap.get("dirty") or {}
            last_cpu = snap.get("cpu")
            stalled = False
            exit_code = None
            last_update_m = 0.0
            last_snap_m = time.monotonic()
            head_cur, commits_cur = head0, commits0
            tail_cur = ""
            while True:
                if stop_requested["flag"] or _stop_marker_present():
                    _kill_process_group(proc, signal.SIGTERM)
                    try:
                        proc.wait(timeout=5)
                    except Exception:
                        _kill_process_group(proc, signal.SIGKILL)
                        try:
                            proc.wait(timeout=5)
                        except Exception:
                            pass
                    try:
                        jf.close()
                    except Exception:
                        pass
                    try:
                        ef.close()
                    except Exception:
                        pass
                    redact_file_inplace(jsonl_path, secrets)
                    redact_file_inplace(err_path, secrets)
                    tail = "\n".join(read_tail_filtered(err_path))
                    return finish_terminal("stopped", k, n, "stopped", accept_exit,
                                           current_last_event, redact_text(tail, secrets))
                ret = proc.poll()
                now_m = time.monotonic()
                if ret is None:
                    activity = False
                    try:
                        cur_jsonl = os.path.getsize(jsonl_path)
                    except OSError:
                        cur_jsonl = last_jsonl_size
                    try:
                        cur_err = os.path.getsize(err_path)
                    except OSError:
                        cur_err = last_err_size
                    if cur_jsonl > last_jsonl_size:
                        activity = True
                        last_jsonl_size = cur_jsonl
                    if cur_err > last_err_size:
                        activity = True
                        last_err_size = cur_err
                    # Heavy signals (git + CPU) at most once per poll_sec.
                    if now_m - last_snap_m >= poll_sec:
                        try:
                            snap = get_activity_snapshot(cwd, proc.pid)
                        except Exception:
                            snap = None
                        if isinstance(snap, dict):
                            if snap.get("head") != last_head:
                                activity = True
                                last_head = snap.get("head")
                            if snap.get("status") != last_status_out:
                                activity = True
                                last_status_out = snap.get("status")
                            cur_dirty = snap.get("dirty") or {}
                            if cur_dirty != last_dirty:
                                activity = True
                                last_dirty = cur_dirty
                            cur_cpu = snap.get("cpu")
                            if (isinstance(cur_cpu, (int, float)) and
                                    isinstance(last_cpu, (int, float)) and
                                    cur_cpu > last_cpu):
                                activity = True
                            if isinstance(cur_cpu, (int, float)):
                                last_cpu = cur_cpu
                        last_snap_m = now_m
                    if consult_max > 0:
                        try:
                            if maybe_handle_consult(k):
                                activity = True
                                # A consult blocks this loop, so now_m
                                # predates it: restart the stall clock
                                # from now, or a long consult eats the
                                # stall budget.
                                now_m = time.monotonic()
                                last_activity_iso = now_iso()
                        except Exception as e:
                            slog("consult handling failed: %s" % e)
                    if activity:
                        last_activity_m = now_m
                        last_activity_iso = now_iso()
                    else:
                        if now_m - last_activity_m >= stall_sec:
                            # Completed-then-hung: the JSONL already has a
                            # completion, the process just never exited. Kill
                            # it and treat the attempt as completed.
                            hung_ok, _ = check_completion(jsonl_path)
                            slog("step %d attempt %d stalled after %.1fs; killing pgid %d" % (k, n, now_m - last_activity_m, proc.pid))
                            _kill_process_group(proc, signal.SIGTERM)
                            try:
                                proc.wait(timeout=5)
                            except Exception:
                                _kill_process_group(proc, signal.SIGKILL)
                                try:
                                    proc.wait(timeout=5)
                                except Exception:
                                    pass
                            try:
                                exit_code = proc.returncode
                            except Exception:
                                exit_code = None
                            if hung_ok:
                                slog("step %d attempt %d had completed before the stall; treating as completed" % (k, n))
                                break
                            stalled = True
                            break
                should_update = (now_m - last_update_m >= poll_sec) or (ret is not None)
                if should_update:
                    head_cur, commits_cur = git_snapshot()
                    tail_cur = "\n".join(read_tail_filtered(err_path))
                    tail_cur = redact_text(tail_cur, secrets)
                    ev, _ = read_last_json_info(jsonl_path)
                    if ev is not None:
                        current_last_event = redact_text(ev, secrets)
                    write_state("running", k, n, proc.pid if ret is None else None,
                                last_activity_iso, current_last_event,
                                head_cur, commits_cur, tail_cur, accept_exit, None, last_reason,
                                muse_started=muse_started if ret is None else None)
                    last_update_m = now_m
                if ret is not None:
                    exit_code = ret
                    break
                time.sleep(min(0.2, poll_sec))
            try:
                jf.close()
            except Exception:
                pass
            try:
                ef.close()
            except Exception:
                pass
            _chmod_0600(jsonl_path)
            _chmod_0600(err_path)
            # Refresh tail/event one last time for this attempt.
            try:
                with open(err_path, "r", encoding="utf-8", errors="replace") as _ef:
                    stderr_full = _ef.read()
            except (FileNotFoundError, OSError):
                stderr_full = ""
            tail_final = "\n".join(read_tail_filtered(err_path))
            tail_final = redact_text(tail_final, secrets)
            ev, _ = read_last_json_info(jsonl_path)
            if ev is not None:
                current_last_event = redact_text(ev, secrets)
            verdict = get_terminal_verdict(jsonl_path)
            v_term = verdict.get("terminal") if verdict.get("has_event") else None
            v_reason = verdict.get("reason") or ""
            if stalled:
                cls, reason = classify_failure(v_term, v_reason or "stalled",
                                               stderr_full, exit_code, stalled=True)
                reason = redact_text(reason, secrets)
                last_reason = reason
                redact_file_inplace(jsonl_path, secrets)
                redact_file_inplace(err_path, secrets)
                history.setdefault(str(k), []).append({
                    "attempt": n, "reason": reason, "ok": False,
                    "class": cls, "terminal": v_term, "exit": exit_code})
                save_history()
                slog("step %d attempt %d failed: %s [%s]" % (k, n, reason, cls))
                if cls == "fatal":
                    return finish_terminal("gave_up", k, n, reason, accept_exit,
                                           current_last_event, tail_final)
                if n >= MAX_ATTEMPTS:
                    return finish_terminal("gave_up", k, n, reason, accept_exit,
                                           current_last_event, tail_final)
                delay = backoff[min(n - 1, len(backoff) - 1)]
                retry_at = (datetime.datetime.now(datetime.timezone.utc) +
                            datetime.timedelta(seconds=delay)).isoformat()
                head_cur, commits_cur = git_snapshot()
                write_state("retry_wait", k, n, None, last_activity_iso, current_last_event,
                            head_cur, commits_cur, tail_final, accept_exit, retry_at, reason)
                res = sleep_with_state_updates(delay, "retry_wait", k, n, retry_at, reason, err_path)
                prev = load_json(state_path, {}) or {}
                if current_last_event is not None:
                    prev["last_event"] = current_last_event
                    try:
                        atomic_write_json(state_path, prev)
                    except OSError:
                        pass
                if res == "stopped":
                    return finish_terminal("stopped", k, n, "stopped", accept_exit,
                                           current_last_event, tail_final)
                continue
            ok, text = check_completion(jsonl_path)
            redact_file_inplace(jsonl_path, secrets)
            redact_file_inplace(err_path, secrets)
            tail_final = "\n".join(read_tail_filtered(err_path))
            tail_final = redact_text(tail_final, secrets)
            try:
                with open(err_path, "r", encoding="utf-8", errors="replace") as _ef2:
                    stderr_full = _ef2.read()
            except (FileNotFoundError, OSError):
                pass
            if ok:
                red_text = redact_text(text or "", secrets)
                try:
                    atomic_write_text(os.path.join(ldir, "step%d-final.md" % k), red_text)
                except OSError as e:
                    slog("failed to write final: %s" % e)
                history.setdefault(str(k), []).append({
                    "attempt": n, "reason": None, "ok": True,
                    "class": "ok", "terminal": "completed", "exit": exit_code})
                save_history()
                slog("step %d completed on attempt %d" % (k, n))
                step_done = True
                head_cur, commits_cur = git_snapshot()
                write_state("running", k, n, None, now_iso(), current_last_event,
                            head_cur, commits_cur, tail_final, accept_exit, None, last_reason)
                break
            if exit_code is not None and exit_code < 0:
                base_reason = "signal %d" % (-exit_code)
            elif exit_code == 0:
                base_reason = v_reason.strip() or "exit 0 without terminal completion"
            else:
                base_reason = v_reason.strip() or ("exit %s" % (exit_code if exit_code is not None else "unknown"))
            cls, reason = classify_failure(v_term, base_reason, stderr_full, exit_code)
            reason = redact_text(reason, secrets)
            last_reason = reason
            history.setdefault(str(k), []).append({
                "attempt": n, "reason": reason, "ok": False,
                "class": cls, "terminal": v_term, "exit": exit_code})
            save_history()
            slog("step %d attempt %d failed: %s [%s terminal=%s]" % (k, n, reason, cls, v_term))
            if cls == "fatal":
                return finish_terminal("gave_up", k, n, reason, accept_exit,
                                       current_last_event, tail_final)
            if cls == "once":
                # At most one more attempt after a "once" failure: count
                # "once" failures in this step; the second one gives up.
                once_count = sum(1 for e in history.get(str(k), [])
                                 if not e.get("ok") and e.get("class") == "once")
                if once_count >= 2 or n >= MAX_ATTEMPTS:
                    return finish_terminal("gave_up", k, n, reason, accept_exit,
                                           current_last_event, tail_final)
            else:
                if n >= MAX_ATTEMPTS:
                    return finish_terminal("gave_up", k, n, reason, accept_exit,
                                           current_last_event, tail_final)
            delay = backoff[min(n - 1, len(backoff) - 1)]
            retry_at = (datetime.datetime.now(datetime.timezone.utc) +
                        datetime.timedelta(seconds=delay)).isoformat()
            head_cur, commits_cur = git_snapshot()
            write_state("retry_wait", k, n, None, now_iso(), current_last_event,
                        head_cur, commits_cur, tail_final, accept_exit, retry_at, reason)
            res = sleep_with_state_updates(delay, "retry_wait", k, n, retry_at, reason, err_path)
            prev = load_json(state_path, {}) or {}
            if current_last_event is not None:
                prev["last_event"] = current_last_event
                try:
                    atomic_write_json(state_path, prev)
                except OSError:
                    pass
            if res == "stopped":
                return finish_terminal("stopped", k, n, "stopped", accept_exit,
                                       current_last_event, tail_final)
        if not step_done:
            # Should be unreachable (gave_up returns), but guard anyway.
            return finish_terminal("gave_up", k, MAX_ATTEMPTS, last_reason or "out of attempts",
                                   accept_exit, current_last_event, "")
        if lane_scope:
            try:
                violating = scope_violating_paths(cwd, head_start, lane_scope)
            except Exception as e:
                slog("scope check failed: %s" % e)
                violating = []
            if violating:
                detail = ", ".join(violating)[:SCOPE_DETAIL_CAP]
                raise_needs_lead("scope_violation", detail, step=k)
                reason = "scope violation: %s" % detail
                last_reason = redact_text(reason, secrets)
                try:
                    _tail = tail_final
                except NameError:
                    _tail = ""
                return finish_terminal("failed", k, n, last_reason,
                                       accept_exit, current_last_event, _tail)
        return ("ok",)

    # ---- box queue (tickets order accepts on one box) ----
    def fresh_lane_box():
        """Lane's box, re-read so an answer --box move lands mid-wait."""
        try:
            fresh = load_json(lane_path, None)
            if isinstance(fresh, dict):
                b = fresh.get("box")
                if isinstance(b, str) and b.strip():
                    return b.strip()
        except Exception:
            pass
        try:
            b0 = lane.get("box")
            if isinstance(b0, str) and b0.strip():
                return b0.strip()
        except Exception:
            pass
        return None

    def take_box_ticket(box):
        """Take a ticket in box. Returns (ticket_name, queued_iso).

        Clears this lane's stale tickets first (a resume re-queues fresh).
        (None, None) degrades to an unguarded accept; the gate script stays
        the real guard.
        """
        del pending_box_moves[:]
        for stale_box, stale_fn in find_own_box_tickets(lane_id):
            remove_box_ticket(stale_box, stale_fn)
        bdir = os.path.join(boxes_root(), box)
        try:
            os.makedirs(bdir, exist_ok=True)
        except OSError as e:
            slog("box %s: cannot create ticket dir: %s" % (box, e))
            return (None, None)
        name = None
        body = ""
        for _try in range(2):
            now = datetime.datetime.now(datetime.timezone.utc)
            name = "%s-%s" % (box_ticket_stamp(now), lane_id)
            body = json.dumps({"lane": lane_id, "box": box,
                               "queued_at": now.isoformat(),
                               "pid": os.getpid()}) + "\n"
            try:
                fd = os.open(os.path.join(bdir, name),
                             os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
            except FileExistsError:
                time.sleep(0.002)
                continue
            except OSError as e:
                slog("box %s: cannot take ticket: %s" % (box, e))
                return (None, None)
            try:
                with os.fdopen(fd, "w", encoding="utf-8") as f:
                    f.write(body)
            except OSError as e:
                slog("box %s: cannot write ticket: %s" % (box, e))
                remove_box_ticket(box, name)
                return (None, None)
            return (name, now.isoformat())
        slog("box %s: ticket name collision; proceeding without a ticket" % box)
        return (None, None)

    def release_box_ticket(ticket_name):
        """Remove own tickets from every box dir; clear box holders. Idempotent.

        Removes the named ticket plus any other own ticket: a lead move
        may have renamed ours after we last looked.
        """
        if ticket_name:
            broot = boxes_root()
            try:
                boxes = os.listdir(broot)
            except OSError:
                boxes = []
            for box in boxes:
                remove_box_ticket(box, ticket_name)
        for _box, _fn in find_own_box_tickets(lane_id):
            remove_box_ticket(_box, _fn)
        box_state_holder["v"] = None
        box_queued_at_holder["v"] = None

    def wait_for_box(box, ticket_name, last_att0):
        """Wait until our ticket is first among live tickets.

        Returns ("held", box) or ("finished", code) after a stop. Heartbeats
        state so the wait never reads as a stall; past the budget raises
        box_wait_timeout once and keeps waiting in place. Lead box moves
        (answer --box sidecars) are applied here, in the same poll
        iteration that decides whether to hold: the move lands, the wait
        clock resets, an open box_wait_timeout clears, then the hold is
        decided. The box still comes from lane.json each poll and the
        ticket is adopted from the box dir, so an orphaned direct move
        also lands mid-wait.
        """
        box_queued_at_holder["v"] = now_iso()
        box_state_holder["v"] = "queued"
        set_phase("box_wait")
        slog("box %s: queued with ticket %s" % (box, ticket_name))
        # Inside the wait before the entry heartbeat: a sidecar already
        # present merges as queued, not as "lane not waiting".
        in_box_wait_holder["v"] = True
        cur_box = box
        head_cur, commits_cur = git_snapshot()
        write_state("accepting", steps, last_att0, None, now_iso(),
                    current_last_event, head_cur, commits_cur, "",
                    None, None, last_reason)
        wait_start_m = time.monotonic()
        timeout_raised = False
        last_update_m = 0.0
        while True:
            if stop_requested["flag"] or _stop_marker_present():
                in_box_wait_holder["v"] = False
                release_box_ticket(ticket_name)
                return ("finished", finish_terminal("stopped", steps, last_att0,
                                                    "stopped", None,
                                                    current_last_event, ""))
            merge_lead_sidecars()
            if pending_box_moves:
                # Supervisor-applied lead moves: lane.json and the ticket
                # move here, before the hold decision below, so no
                # check-then-move race can free the old box under us.
                # Each move re-queues us at the back of the new box and
                # restarts the wait timer and the once-per-wait flag.
                while pending_box_moves:
                    _mv = pending_box_moves.pop(0)
                    _nb = _mv.get("box")
                    if not isinstance(_nb, str) or box_name_error(_nb) is not None:
                        slog("box move to %r ignored: invalid box name" % (_nb,))
                        continue
                    _nb = _nb.strip()
                    try:
                        _fresh_lane = load_json(lane_path, None)
                        if isinstance(_fresh_lane, dict):
                            _fresh_lane["box"] = _nb
                            atomic_write_json(lane_path, _fresh_lane)
                        try:
                            lane["box"] = _nb
                        except Exception:
                            pass
                    except OSError as e:
                        slog("box move to %s failed: cannot write lane: %s" % (_nb, e))
                        continue
                    try:
                        _moved = move_own_box_tickets(lane_id, _nb)
                    except OSError as e:
                        slog("box move to %s failed: cannot move ticket: %s" % (_nb, e))
                        continue
                    cur_box = _nb
                    if _moved:
                        ticket_name = _moved[-1]
                    wait_start_m = time.monotonic()
                    timeout_raised = False
                    box_queued_at_holder["v"] = now_iso()
                    _open = needs_lead_holder.get("current")
                    if isinstance(_open, dict) and _open.get("kind") == "box_wait_timeout":
                        needs_lead_holder["current"] = None
                        slog("box %s: cleared open box_wait_timeout on lead move" % _nb)
                    slog("box move to %s applied; re-queued with ticket %s" % (
                        _nb, ticket_name))
            fresh = fresh_lane_box()
            if fresh:
                cur_box = fresh
            own = find_own_box_tickets(lane_id)
            if not own:
                # Ticket gone from every box dir: re-take our name here.
                try:
                    bdir = os.path.join(boxes_root(), cur_box)
                    os.makedirs(bdir, exist_ok=True)
                    fd = os.open(os.path.join(bdir, ticket_name),
                                 os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
                except (FileExistsError, OSError):
                    pass
                else:
                    try:
                        with os.fdopen(fd, "w", encoding="utf-8") as f:
                            f.write(json.dumps(
                                {"lane": lane_id, "box": cur_box,
                                 "queued_at": box_queued_at_holder["v"],
                                 "pid": os.getpid()}) + "\n")
                    except OSError:
                        pass
                own = [(cur_box, ticket_name)]
            own_here = sorted(fn for (b, fn) in own if b == cur_box)
            if not own_here:
                # Our ticket lives in another box dir: an external move is
                # in flight. Wait for it; never read this as first place.
                older = None
            else:
                if ticket_name not in own_here:
                    # Adopted the moved ticket (fresh stamp, back of the
                    # queue): the wait timer restarts with it.
                    ticket_name = own_here[-1]
                    wait_start_m = time.monotonic()
                    timeout_raised = False
                    box_queued_at_holder["v"] = now_iso()
                    slog("box %s: adopted moved ticket %s" % (cur_box, ticket_name))
                older = box_older_live_tickets(cur_box, ticket_name, lane_id)
            if older is not None and not older:
                break
            now_m = time.monotonic()
            if older and not timeout_raised and now_m - wait_start_m >= box_wait_max_sec:
                raise_needs_lead(
                    "box_wait_timeout",
                    "box %s: queued past %.0fs budget; still queued (%d ahead)" % (
                        cur_box, box_wait_max_sec, len(older)),
                    step=steps)
                timeout_raised = True
            if now_m - last_update_m >= poll_sec:
                head_cur, commits_cur = git_snapshot()
                write_state("accepting", steps, last_att0, None, now_iso(),
                            current_last_event, head_cur, commits_cur, "",
                            None, None, last_reason)
                last_update_m = now_m
            time.sleep(min(0.2, poll_sec))
        in_box_wait_holder["v"] = False
        box_state_holder["v"] = "held"
        cur_nl = needs_lead_holder["current"]
        if isinstance(cur_nl, dict) and cur_nl.get("kind") == "box_wait_timeout":
            # Got the box: an open wait timeout clears at once, so no
            # stale timeout invites a move while the box is held.
            needs_lead_holder["current"] = None
            slog("box %s: holding; cleared open box_wait_timeout" % cur_box)
        head_cur, commits_cur = git_snapshot()
        write_state("accepting", steps, last_att0, None, now_iso(),
                    current_last_event, head_cur, commits_cur, "",
                    None, None, last_reason)
        slog("box %s: holding with ticket %s" % (cur_box, ticket_name))
        return ("held", cur_box)

    # ---- acceptance ----
    # Returns ("accept_done", rc_or_None, last_att, tail) when the accept
    # passed (or there is none), else ("finished", code) after writing a
    # terminal state.
    def run_accept():
        nonlocal secrets
        if not accept_cmd:
            # No acceptance. Keep last attempt info from final step.
            last_k_hist = history.get(str(steps)) or []
            last_att = len(last_k_hist) or 1
            try:
                last_att = int(last_k_hist[-1].get("attempt", last_att)) if last_k_hist else 1
            except Exception:
                pass
            try:
                tail_done = "\n".join(read_tail_filtered(
                    os.path.join(ldir, "step%d-attempt%d.err" % (steps, last_att))))
                tail_done = redact_text(tail_done, secrets)
            except Exception:
                tail_done = ""
            return ("accept_done", None, last_att, tail_done)
        # Run acceptance command.
        if stop_requested["flag"] or _stop_marker_present():
            last_k_hist = history.get(str(steps)) or []
            try:
                last_att0 = int(last_k_hist[-1].get("attempt", 1)) if last_k_hist else 1
            except Exception:
                last_att0 = 1
            return ("finished", finish_terminal("stopped", steps, last_att0, "stopped", None,
                                                current_last_event, ""))
        shell = "/bin/zsh" if os.path.exists("/bin/zsh") else "/bin/sh"
        accept_log = os.path.join(ldir, "accept.log")
        secrets = union_secrets(secret_snapshot, secrets_from_env_file(env_file))
        box_now = fresh_lane_box()
        ticket_name = None
        if box_now:
            ticket_name, _queued_iso = take_box_ticket(box_now)
            if ticket_name is not None:
                box_queued_at_holder["v"] = _queued_iso
        slog("accepting: %s -c %s" % (shell, accept_cmd))
        head_cur, commits_cur = git_snapshot()
        last_k_hist0 = history.get(str(steps)) or []
        try:
            last_att0 = int(last_k_hist0[-1].get("attempt", 1)) if last_k_hist0 else 1
        except Exception:
            last_att0 = 1
        if ticket_name is not None:
            _wres = wait_for_box(box_now, ticket_name, last_att0)
            if _wres[0] == "finished":
                return _wres[1]
            box_now = _wres[1]
        if box_now:
            accept_env["LANE_BOX"] = box_now
        else:
            accept_env.pop("LANE_BOX", None)
        set_phase("accept")
        write_state("accepting", steps, last_att0,
                    None, now_iso(), current_last_event, head_cur, commits_cur, "",
                    None, None, last_reason)
        phase_log_offset = 0
        try:
            alog_f = open(accept_log, "w", encoding="utf-8", errors="replace")
            try:
                os.fchmod(alog_f.fileno(), 0o600)
            except OSError:
                pass
        except OSError as e:
            reason = redact_text("accept spawn failed: %s" % e, secrets)
            try:
                atomic_write_text(accept_log, reason + "\n")
            except OSError:
                pass
            _map = lane_config.get("accept_exit_kinds") or {}
            _m127 = _map.get("127", _map.get(127)) if isinstance(_map, dict) else None
            _k127 = _m127 if _m127 in ACCEPT_MAPPABLE_KINDS else "accept_failed_code"
            raise_needs_lead(_k127, reason, step=steps)
            release_box_ticket(ticket_name)
            return ("finished", finish_terminal("failed", steps, last_att0, reason, 127,
                                                current_last_event, ""))
        try:
            aproc = subprocess.Popen([shell, "-c", accept_cmd], cwd=cwd, env=accept_env,
                                     stdin=subprocess.DEVNULL, stdout=alog_f, stderr=subprocess.STDOUT,
                                     start_new_session=True)
        except Exception as e:
            try:
                alog_f.close()
            except Exception:
                pass
            reason = redact_text("accept spawn failed: %s" % e, secrets)
            try:
                atomic_write_text(accept_log, reason + "\n")
            except OSError:
                pass
            _map = lane_config.get("accept_exit_kinds") or {}
            _m127 = _map.get("127", _map.get(127)) if isinstance(_map, dict) else None
            _k127 = _m127 if _m127 in ACCEPT_MAPPABLE_KINDS else "accept_failed_code"
            raise_needs_lead(_k127, reason, step=steps)
            release_box_ticket(ticket_name)
            return ("finished", finish_terminal("failed", steps, last_att0, reason, 127,
                                                current_last_event, ""))
        try:
            accept_started = get_start_time(aproc.pid)
        except Exception:
            accept_started = None
        accept_start_m = time.monotonic()
        last_update_m = 0.0
        accept_rc = None
        timed_out = False
        while True:
            if stop_requested["flag"] or _stop_marker_present():
                _kill_process_group(aproc, signal.SIGTERM)
                try:
                    aproc.wait(timeout=5)
                except Exception:
                    _kill_process_group(aproc, signal.SIGKILL)
                    try:
                        aproc.wait(timeout=5)
                    except Exception:
                        pass
                try:
                    alog_f.close()
                except Exception:
                    pass
                try:
                    with open(accept_log, "r", encoding="utf-8", errors="replace") as f:
                        lines = f.read().splitlines()
                    atomic_write_text(accept_log, redact_text("\n".join(lines[-60:]) + ("\n" if lines else ""), secrets))
                except OSError:
                    pass
                last_k_hist = history.get(str(steps)) or []
                try:
                    last_att = int(last_k_hist[-1].get("attempt", 1)) if last_k_hist else 1
                except Exception:
                    last_att = 1
                release_box_ticket(ticket_name)
                return ("finished", finish_terminal("stopped", steps, last_att, "stopped", None,
                                                    current_last_event, ""))
            ret = aproc.poll()
            now_m = time.monotonic()
            if ret is None and now_m - accept_start_m >= ACCEPT_TIMEOUT_SEC:
                timed_out = True
                _kill_process_group(aproc, signal.SIGTERM)
                try:
                    aproc.wait(timeout=10)
                except Exception:
                    _kill_process_group(aproc, signal.SIGKILL)
                    try:
                        aproc.wait(timeout=5)
                    except Exception:
                        pass
                ret = aproc.returncode
            if now_m - last_update_m >= poll_sec or ret is not None:
                head_cur, commits_cur = git_snapshot()
                try:
                    with open(accept_log, "r", encoding="utf-8", errors="replace") as _pf:
                        _pf.seek(phase_log_offset)
                        _new = _pf.read()
                        phase_log_offset = _pf.tell()
                    for _ln in _new.splitlines():
                        _m = re.match(r"^LANE-PHASE: (\S+)", _ln)
                        if _m:
                            set_phase(_m.group(1))
                except (FileNotFoundError, OSError):
                    pass
                last_k_hist = history.get(str(steps)) or []
                try:
                    last_att = int(last_k_hist[-1].get("attempt", 1)) if last_k_hist else 1
                except Exception:
                    last_att = 1
                write_state("accepting", steps, last_att, None, now_iso(), current_last_event,
                            head_cur, commits_cur, "", None, None, last_reason,
                            accept_pid=aproc.pid if ret is None else None,
                            accept_started=accept_started if ret is None else None)
                last_update_m = now_m
            if ret is not None:
                accept_rc = ret
                break
            time.sleep(min(0.2, poll_sec))
        try:
            alog_f.close()
        except Exception:
            pass
        full_text = ""
        try:
            with open(accept_log, "r", encoding="utf-8", errors="replace") as f:
                lines = f.read().splitlines()
            full_text = "\n".join(lines)
            atomic_write_text(accept_log, redact_text("\n".join(lines[-60:]) + ("\n" if lines else ""), secrets))
        except OSError:
            pass
        _chmod_0600(accept_log)
        last_k_hist = history.get(str(steps)) or []
        try:
            last_att = int(last_k_hist[-1].get("attempt", 1)) if last_k_hist else 1
        except Exception:
            last_att = 1
        if timed_out:
            last = parse_needs_lead_last(full_text)
            if last is not None:
                tk, td = accept_needs_lead_for_exit(124, full_text, lane_config)
            else:
                _map = lane_config.get("accept_exit_kinds") or {}
                _m = _map.get("124", _map.get(124)) if isinstance(_map, dict) else None
                tk = _m if _m in ACCEPT_MAPPABLE_KINDS else "accept_failed_code"
                td = "accept timeout after 2h"
            raise_needs_lead(tk, td, step=steps)
            release_box_ticket(ticket_name)
            return ("finished", finish_terminal("failed", steps, last_att,
                                                "accept timeout after 2h", 124,
                                                current_last_event, ""))
        if accept_rc is not None and accept_rc != 0:
            if not full_text:
                try:
                    with open(accept_log, "r", encoding="utf-8", errors="replace") as f:
                        full_text = f.read()
                except (FileNotFoundError, OSError):
                    full_text = ""
            ak, ad = accept_needs_lead_for_exit(accept_rc, full_text, lane_config)
            raise_needs_lead(ak, ad, step=steps)
        release_box_ticket(ticket_name)
        return ("accept_done", accept_rc, last_att, "")

    def last_attempt_of_last_step():
        hist = history.get(str(steps)) or []
        try:
            return int(hist[-1].get("attempt", 1)) if hist else 1
        except Exception:
            return 1

    def run_review_round(rnd):
        """Run pre-review round rnd in a fresh muse session.

        Returns ("pass", findings), ("fail", findings), ("error", msg),
        or ("finished", code) after writing a terminal state.
        """
        nonlocal secrets, current_last_event
        secrets = union_secrets(secret_snapshot, secrets_from_env_file(env_file))
        set_phase("review:%d" % rnd)
        try:
            head_now = get_git_head(cwd) if os.path.isdir(cwd) else None
        except Exception:
            head_now = None
        try:
            with open(os.path.join(ldir, "accept.log"), "r", encoding="utf-8",
                      errors="replace") as f:
                accept_tail = "\n".join(f.read().splitlines()[-60:])
        except (FileNotFoundError, OSError):
            accept_tail = ""
        brief_texts = []
        for k in range(1, steps + 1):
            try:
                with open(os.path.join(ldir, "brief%d.md" % k), "r", encoding="utf-8",
                          errors="replace") as f:
                    brief_texts.append(f.read())
            except (FileNotFoundError, OSError):
                brief_texts.append("(missing)")
        stat, full, files = get_review_diff(cwd, head_start, head_now)
        controls = get_control_branches_since(cwd, head_start)
        brief_text = redact_text(build_review_brief(
            lane.get("label") or "", lane.get("id") or lane_id, brief_texts,
            head_start, head_now, stat, full, files, accept_cmd, accept_exit,
            accept_tail, controls, rnd, review_total, review_extra), secrets)
        brief_path = os.path.join(ldir, "review-brief%d.md" % rnd)
        try:
            atomic_write_text(brief_path, brief_text)
        except OSError as e:
            err = redact_text("cannot write review brief: %s" % e, secrets)
            review_error_holder["v"] = err
            review_rounds_done.append({"round": rnd, "verdict": "ERROR", "error": err,
                                       "findings_preview": ""})
            return ("error", err)
        jsonl_path = os.path.join(ldir, "review%d.jsonl" % rnd)
        err_path = os.path.join(ldir, "review%d.err" % rnd)
        cmd = [muse_bin, "exec", "--prompt-file", brief_path,
               "--trust-workspace", "--approval-mode", "never",
               "--disable-approval", "--disable-write",
               "--reasoning-effort", effort, "--json",
               # Owner 2026-10-16: no network from inside Muse's shell sandbox (two lanes built ssh stand-ins
               # to reach the lab runner with ~/.ssh keys). Remote steps run in the unsandboxed accept.
               "--sandbox-network", os.environ.get("MUSE_LANE_SANDBOX_NETWORK", "restricted")]
        slog("review round %d: %s" % (rnd, " ".join(cmd)))
        last_att = last_attempt_of_last_step()
        head_cur, commits_cur = git_snapshot()
        write_state("running", steps, last_att, None, now_iso(), current_last_event,
                    head_cur, commits_cur, "", accept_exit, None, last_reason)
        try:
            jf = open(jsonl_path, "w", encoding="utf-8", errors="replace")
            try:
                os.fchmod(jf.fileno(), 0o600)
            except OSError:
                pass
            ef = open(err_path, "w", encoding="utf-8", errors="replace")
            try:
                os.fchmod(ef.fileno(), 0o600)
            except OSError:
                pass
        except OSError as e:
            try:
                jf.close()
            except Exception:
                pass
            try:
                ef.close()
            except Exception:
                pass
            err = redact_text("cannot open review output files: %s" % e, secrets)
            review_error_holder["v"] = err
            review_rounds_done.append({"round": rnd, "verdict": "ERROR", "error": err,
                                       "findings_preview": ""})
            return ("error", err)
        # Tracked-tree snapshot: the review session is read-only and must not
        # change HEAD or any tracked file; compared again after it exits.
        try:
            head_before = get_git_head(cwd) if os.path.isdir(cwd) else None
        except Exception:
            head_before = None
        status_before = get_git_status_tracked(cwd)
        try:
            proc = subprocess.Popen(cmd, cwd=cwd, env=muse_env,
                                    stdin=subprocess.DEVNULL, stdout=jf, stderr=ef,
                                    start_new_session=True)
        except Exception as e:
            try:
                jf.close()
            except Exception:
                pass
            try:
                ef.close()
            except Exception:
                pass
            err = redact_text("review spawn failed: %s" % e, secrets)
            review_error_holder["v"] = err
            review_rounds_done.append({"round": rnd, "verdict": "ERROR", "error": err,
                                       "findings_preview": ""})
            return ("error", err)
        try:
            muse_started_v = get_start_time(proc.pid)
        except Exception:
            muse_started_v = None
        start_m = time.monotonic()
        last_update_m = 0.0
        timed_out = False
        rc = None
        while True:
            if stop_requested["flag"] or _stop_marker_present():
                _kill_process_group(proc, signal.SIGTERM)
                try:
                    proc.wait(timeout=5)
                except Exception:
                    _kill_process_group(proc, signal.SIGKILL)
                    try:
                        proc.wait(timeout=5)
                    except Exception:
                        pass
                try:
                    jf.close()
                except Exception:
                    pass
                try:
                    ef.close()
                except Exception:
                    pass
                redact_file_inplace(jsonl_path, secrets)
                redact_file_inplace(err_path, secrets)
                tail = "\n".join(read_tail_filtered(err_path))
                return ("finished", finish_terminal("stopped", steps, last_att, "stopped",
                                                    accept_exit, current_last_event,
                                                    redact_text(tail, secrets)))
            ret = proc.poll()
            now_m = time.monotonic()
            if ret is None and now_m - start_m >= review_timeout_sec:
                timed_out = True
                slog("review round %d timed out after %.0fs; killing pgid %d" % (
                    rnd, now_m - start_m, proc.pid))
                _kill_process_group(proc, signal.SIGTERM)
                try:
                    proc.wait(timeout=10)
                except Exception:
                    _kill_process_group(proc, signal.SIGKILL)
                    try:
                        proc.wait(timeout=5)
                    except Exception:
                        pass
                ret = proc.returncode
            if now_m - last_update_m >= poll_sec or ret is not None:
                head_cur, commits_cur = git_snapshot()
                ev, _ = read_last_json_info(jsonl_path)
                if ev is not None:
                    current_last_event = redact_text(ev, secrets)
                write_state("running", steps, last_att, proc.pid if ret is None else None,
                            now_iso(), current_last_event, head_cur, commits_cur, "",
                            accept_exit, None, last_reason,
                            muse_started=muse_started_v if ret is None else None)
                last_update_m = now_m
            if ret is not None:
                rc = ret
                break
            time.sleep(min(0.2, poll_sec))
        try:
            jf.close()
        except Exception:
            pass
        try:
            ef.close()
        except Exception:
            pass
        _chmod_0600(jsonl_path)
        _chmod_0600(err_path)
        redact_file_inplace(jsonl_path, secrets)
        redact_file_inplace(err_path, secrets)
        try:
            head_after = get_git_head(cwd) if os.path.isdir(cwd) else None
        except Exception:
            head_after = None
        status_after = get_git_status_tracked(cwd)
        if ((head_before or "") != (head_after or "")
                or (status_before or "") != (status_after or "")):
            changed = review_changed_paths(cwd, head_before, head_after,
                                            status_before, status_after)
            detail = "review session changed tracked files" + (
                ": " + ", ".join(changed) if changed else "")
            slog(detail)
            review_error_holder["v"] = detail
            review_rounds_done.append({"round": rnd, "verdict": "ERROR",
                                       "error": detail, "findings_preview": ""})
            return ("finished", finish_terminal(
                "failed", steps, last_attempt_of_last_step(),
                "review session changed tracked files", accept_exit,
                current_last_event, ""))
        _rok, _rtext = check_completion(jsonl_path)
        verdict_text = _rtext or ""
        if timed_out:
            err = "review round %d timed out after %.0fs" % (rnd, review_timeout_sec)
            slog(err)
            review_error_holder["v"] = err
            review_rounds_done.append({"round": rnd, "verdict": "ERROR", "error": err,
                                       "findings_preview": ""})
            return ("error", err)
        verdict, findings = parse_review_verdict(verdict_text)
        if verdict is None:
            if rc != 0:
                tail = "\n".join(read_tail_filtered(err_path))
                last_line = tail.splitlines()[-1] if tail.splitlines() else ""
                err = redact_text("review round %d crashed (exit %s): %s" % (
                    rnd, rc, last_line), secrets)
            else:
                err = "review round %d produced no PASS/FAIL verdict" % rnd
            slog(err)
            review_error_holder["v"] = err
            review_rounds_done.append({"round": rnd, "verdict": "ERROR", "error": err,
                                       "findings_preview": redact_text(
                                           (verdict_text or "")[:REVIEW_PREVIEW_CHARS], secrets)})
            return ("error", err)
        # A PASS that still lists a blocker or should-fix finding is a FAIL
        # the reviewer mislabeled; the supervisor overrides it and runs the
        # fix round. The verdict file keeps the reviewer's verbatim text.
        overridden = ""
        if verdict == "PASS" and pass_has_severe_findings(findings):
            overridden = "PASS overridden: should-fix findings"
            verdict = "FAIL"
        # The reviewer cannot write (--disable-write); the supervisor records
        # its final answer as the verdict file, in the worktree and the lane.
        verdict_body = redact_text(verdict_text if verdict_text.endswith("\n")
                                   else verdict_text + "\n", secrets)
        for _vp in (os.path.join(cwd, ".lane", "REVIEW-%d.md" % rnd),
                    os.path.join(ldir, "REVIEW-%d.md" % rnd)):
            try:
                atomic_write_text(_vp, verdict_body)
            except OSError as e:
                slog("failed to write review verdict %s: %s" % (_vp, e))
        review_rounds_done.append({"round": rnd, "verdict": verdict, "error": None,
                                   "overridden": overridden,
                                   "findings_preview": redact_text(
                                       (findings or "")[:REVIEW_PREVIEW_CHARS], secrets)})
        head_cur, commits_cur = git_snapshot()
        write_state("running", steps, last_att, None, now_iso(), current_last_event,
                    head_cur, commits_cur, "", accept_exit, None, last_reason)
        if overridden:
            slog("review round %d: FAIL (%s)" % (rnd, overridden))
        else:
            slog("review round %d: %s" % (rnd, verdict))
        if verdict == "PASS":
            return ("pass", findings or "")
        return ("fail", findings or "")

    def archive_last_step_for_rerun(rnd):
        k = steps
        hkey = str(k)
        if history.get(hkey):
            history["%s-pre-r%d" % (hkey, rnd)] = history.pop(hkey)
            save_history()
        try:
            names = os.listdir(ldir)
        except OSError:
            names = []
        prefix = "step%d-attempt" % k
        for fn in names:
            if fn.startswith(prefix):
                try:
                    os.rename(os.path.join(ldir, fn),
                              os.path.join(ldir, "%s-pre-r%d" % (fn, rnd)))
                except OSError:
                    pass
        final_p = os.path.join(ldir, "step%d-final.md" % k)
        if os.path.exists(final_p):
            try:
                os.rename(final_p, os.path.join(ldir, "step%d-final-pre-r%d.md" % (k, rnd)))
            except OSError:
                pass
        brief_p = os.path.join(ldir, "brief%d.md" % k)
        orig_p = os.path.join(ldir, "brief%d-orig.md" % k)
        if not os.path.exists(orig_p) and os.path.exists(brief_p):
            try:
                shutil.copyfile(brief_p, orig_p)
                _chmod_0600(orig_p)
            except OSError:
                pass

    def augment_last_brief(rnd, findings):
        brief_p = os.path.join(ldir, "brief%d.md" % steps)
        try:
            with open(brief_p, "r", encoding="utf-8", errors="replace") as f:
                cur = f.read()
        except (FileNotFoundError, OSError):
            cur = ""
        add = ("\n\n# Muse pre-review findings (round %d, verdict FAIL)\n\n"
               "Your previous attempt was reviewed and failed. "
               "Address every numbered finding:\n\n%s\n") % (
                   rnd, (findings or "(no findings text)").strip())
        try:
            atomic_write_text(brief_p, (cur.rstrip() + "\n" + add) if cur.strip() else add)
        except OSError as e:
            slog("failed to augment brief for re-run: %s" % e)

    # ---- main step loop (first pass) ----
    if start_step <= steps:
        for k in range(start_step, steps + 1):
            ns = start_attempt if k == start_step else 1
            res = run_step(k, os.path.join(ldir, "brief%d.md" % k), ns)
            if not (isinstance(res, tuple) and res and res[0] == "ok"):
                return res

    # ---- acceptance (first pass; skipped when resuming past a passed accept) ----
    if skip_accept:
        ares = ("accept_done", accept_exit, last_attempt_of_last_step(), "")
    else:
        ares = run_accept()
    if ares[0] == "finished":
        return ares[1]
    _, arc, alast, atail = ares
    accept_exit = arc
    if arc is not None and arc != 0:
        return finish_terminal("failed", steps, alast, "accept exit %s" % arc, arc,
                               current_last_event, "")
    if not review_enabled:
        return finish_terminal("done", steps, alast, last_reason, arc, current_last_event, atail)

    # ---- pre-review: 1 initial review, then one fix + review per round ----
    for rnd in range(len(review_rounds_done) + 1, review_total + 1):
        rres = run_review_round(rnd)
        if rres[0] == "finished":
            return rres[1]
        if rres[0] == "pass":
            return finish_terminal("done", steps, last_attempt_of_last_step(),
                                   last_reason, accept_exit, current_last_event, "")
        if rres[0] == "error":
            return finish_terminal("done", steps, last_attempt_of_last_step(),
                                   last_reason, accept_exit, current_last_event, "")
        if rnd >= review_total:
            _find = (rres[1] or "").strip()[:NEEDS_LEAD_DETAIL_CAP]
            _det = _find or "pre-review FAILed with no fix re-runs left"
            raise_needs_lead("review_failed", _det, step=steps)
            return finish_terminal("review_failed", steps, last_attempt_of_last_step(),
                                   "pre-review FAILed with no fix re-runs left",
                                   accept_exit, current_last_event, "")
        findings = rres[1]
        slog("review round %d FAILed; re-running step %d" % (rnd, steps))
        archive_last_step_for_rerun(rnd)
        augment_last_brief(rnd, findings)
        res = run_step(steps, os.path.join(ldir, "brief%d.md" % steps), 1)
        if not (isinstance(res, tuple) and res and res[0] == "ok"):
            return res
        ares2 = run_accept()
        if ares2[0] == "finished":
            return ares2[1]
        _, arc2, alast2, _ = ares2
        accept_exit = arc2
        if arc2 is not None and arc2 != 0:
            return finish_terminal("failed", steps, alast2, "accept exit %s" % arc2, arc2,
                                   current_last_event, "")


def build_parser():
    p = argparse.ArgumentParser(prog="muse-lane", description="Supervisor for long headless Muse runs.")
    sub = p.add_subparsers(dest="cmd", required=True)
    ps = sub.add_parser("start", help="Start a new lane.")
    ps.add_argument("--cwd", required=True, help="Working directory for muse and acceptance.")
    ps.add_argument("--brief", dest="briefs", action="append", required=True, help="Brief markdown file (repeatable).")
    ps.add_argument("--id", default=None, help="Lane id (default: timestamp-slug).")
    ps.add_argument("--label", default="", help="Human label.")
    ps.add_argument("--accept", default=None, help="Acceptance shell command.")
    ps.add_argument("--effort", default="max", help="Reasoning effort (default: max).")
    ps.add_argument("--env-file", default=None, help="KEY=VALUE file added to the environment.")
    ps.add_argument("--accept-env", action="store_true", help="Pass env-file keys to the acceptance command.")
    ps.add_argument("--stall-min", type=float, default=40.0, help="Stall minutes (default: 40).")
    ps.add_argument("--owner-session", default=None, help="Owning session id for wake-ups.")
    ps.add_argument("--review", action="store_true", help="Run a Muse pre-review after a passing accept.")
    ps.add_argument("--review-brief", default=None, help="Extra review instructions (text, or a file path to read).")
    ps.add_argument("--review-rounds", type=int, default=1, help="Max fix re-runs after a FAIL review (default: 1; 0 reviews once with no fix).")
    ps.add_argument("--consult-max", type=int, default=3, help="Max consult answers per step, 0 disables (default: 3).")
    ps.add_argument("--consult-timeout-min", type=float, default=15.0, help="Consult helper timeout in minutes (default: 15).")
    ps.add_argument("--scope", dest="scope", action="append", default=None,
                    help="Allowed path glob for changed files (repeatable; fnmatch, ** allowed).")
    ps.add_argument("--box", default=None, help="Box name: accepts on one box run strictly in ticket order.")
    ps.add_argument("--advisor-model", default=None, choices=["sonnet", "opus"],
                    help="Advisor model (default with --advisor-max: sonnet; no flag = no advisor).")
    ps.add_argument("--advisor-max", type=int, default=None,
                    help="Advisor calls per lane (default with --advisor-model: 3).")
    pr = sub.add_parser("_run", help="Run the supervisor (internal).")
    pr.add_argument("id", help="Lane id.")
    pt = sub.add_parser("status", help="Show lane status.")
    pt.add_argument("id", nargs="?", default=None, help="Lane id (default: all).")
    pt.add_argument("--json", action="store_true", help="Print JSON list.")
    pt.add_argument("--active", action="store_true",
                    help="Only live lanes plus those ended in the last 24h.")
    pt.add_argument("--limit", type=int, default=None,
                    help="Max lanes listed, newest first.")
    pk = sub.add_parser("stop", help="Stop a lane.")
    pk.add_argument("id", help="Lane id.")
    pm = sub.add_parser("resume", help="Resume an orphaned lane.")
    pm.add_argument("id", help="Lane id.")
    py = sub.add_parser("summary", help="Print a lane summary.")
    py.add_argument("id", help="Lane id.")
    prt = sub.add_parser("root", help="Print the lanes root directory.")
    pa = sub.add_parser("ack", help="Claim a lane announcement (exactly-once).")
    pa.add_argument("id", help="Lane id.")
    pa.add_argument("--orphan", action="store_true",
                    help="Claim the orphan announcement for the current incarnation.")
    pa.add_argument("--lead", default=None,
                    help="Claim the needs-lead announcement for this seq.")
    pw = sub.add_parser("answer", help="Reply to a lane (writes .lane/ANSWER.md).")
    pw.add_argument("id", help="Lane id.")
    pw.add_argument("--text", default=None, help="Reply text.")
    pw.add_argument("--text-file", default=None, help="File containing reply text.")
    pw.add_argument("--box", default=None, help="Move the lane's box ticket to this box (back of its queue).")
    pb = sub.add_parser("boxes", help="Show box queues and lease holders.")
    pb.add_argument("--json", action="store_true", help="Print JSON list.")
    return p


def cmd_root(_args):
    print(lanes_root())
    return 0


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.cmd == "start":
        return cmd_start(args)
    if args.cmd == "_run":
        return cmd_run(args.id)
    if args.cmd == "status":
        return cmd_status(args)
    if args.cmd == "stop":
        return cmd_stop(args)
    if args.cmd == "resume":
        return cmd_resume(args)
    if args.cmd == "summary":
        return cmd_summary(args)
    if args.cmd == "root":
        return cmd_root(args)
    if args.cmd == "ack":
        return cmd_ack(args)
    if args.cmd == "answer":
        return cmd_answer(args)
    if args.cmd == "boxes":
        return cmd_boxes(args)
    parser.print_help()
    return 2


if __name__ == "__main__":
    sys.exit(main())
